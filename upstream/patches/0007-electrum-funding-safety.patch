diff --git a/basicswap/interface/electrumx.py b/basicswap/interface/electrumx.py
index b640329..c7d60a5 100644
--- a/basicswap/interface/electrumx.py
+++ b/basicswap/interface/electrumx.py
@@ -454,7 +454,16 @@ def scripthash_from_address(address, network_params):
             script = CScript(
                 [OP_DUP, OP_HASH160, addr_hash, OP_EQUALVERIFY, OP_CHECKSIG]
             )
-        elif addr_type == network_params.get("script_address"):
+        elif addr_type == network_params.get("script_address") or (
+            network_params.get("script_address2") is not None
+            and addr_type == network_params.get("script_address2")
+        ):
+            # PWNDA-PATCH-7: some coins (LTC) mint P2SH under a SECOND
+            # version byte -- script_address2 -- after deprecating the
+            # first one shared with Bitcoin. Falling through to the bech32
+            # branch below for that byte hashes a script the address never
+            # had (P2WPKH instead of P2SH), matching BTCInterface's own
+            # getDestForAddress(), which already checks both.
             script = CScript([OP_HASH160, addr_hash, OP_EQUAL])
         else:
             script = CScript([OP_0, addr_hash])

