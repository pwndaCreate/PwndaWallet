+    def _cacheMainWalletIdentityIfUnset(self, when: str) -> None:
+        # PWNDA-PATCH-35: the "host confirms its wallet's identity" moment, on
+        # every node start -- not only inside initialiseWallet, which a running
+        # node never calls for ZANO (bin/prepare.py, reseedWallet and XMR-only
+        # debug code are its only callers). With the confirmation there alone,
+        # _cached_main_wallet_address stayed None for the life of every node and
+        # _confirmMainWalletIdentity refused every spend from the host wallet:
+        # 2026-09-13, the first funded ZANO<>LTC swap, 100 publishBLockTx
+        # retries over 18 h, all "expected confirmed identity None; refusing to
+        # send". XMR never had this gap because PATCH-8 caches in openWallet,
+        # which runs at every start; ZANO's openWallet is a no-op.
+        #
+        # Same rule as XMRInterface.openWallet: confirm ONCE, while still None,
+        # from a non-spend path. Never call this from inside the spend guard --
+        # a guard that fills its own reference from the live read it compares
+        # against would pass for any wallet. Callers: unlockWallet (the node's
+        # start) and getWalletInfo (the periodic read, so a host wallet that was
+        # briefly unreachable at unlock is still confirmed before any spend).
+        #
+        # The caller must hold self._mx_wallet.
+        if not self._external_main_wallet:
+            return
+        if self._cached_main_wallet_address is not None:
+            return
+        try:
+            address = self.rpc_wallet("getaddress")["address"]
+        except Exception as e:
+            self._log.warning(
+                f"PWNDA-PATCH-35: could not confirm the ZANO main wallet identity at "
+                f"{when} (spends stay refused until it is confirmed): {e}"
+            )
+            return
+        if not address:
+            return
+        self._cached_main_wallet_address = address
+        self._log.info(
+            f"PWNDA-PATCH-35: confirmed the ZANO main wallet identity at {when}: "
+            f"{address}"
+        )
+
