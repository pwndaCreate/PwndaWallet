         key = self._deriveKey(coin_type, index, internal)
         pubkey = PublicKey.from_secret(key).format()
         pkh = hash160(pubkey)
+        if coin_type == Coins.BCH:
+            # PWNDA-PATCH-18: BCH has no bech32/segwit address at all (see
+            # bch.py's has_segwit() comment) -- it is P2PKH with a CashAddr
