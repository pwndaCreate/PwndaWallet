+            # PWNDA-PATCH-27 -- Gate 2b: the engine's own record says the
+            # chain-A redeem was PUBLISHED. When the chain agrees (>= 1
+            # confirmation) the swap is financially complete for the side that
+            # redeemed A, and BID_ERROR is a bookkeeping error, not a swap
+            # error: re-queueing the redeem (below) would return early from
+            # redeemXmrBidCoinALockTx ("already redeemed") and leave the bid
+            # resting at LOCK_RELEASED forever, still "in progress". Settle it
+            # exactly as process_XMR_SWAP_A_LOCK_tx_spend would have when it
+            # saw the spend -- same states, same event, same notification --
+            # then deactivate it so it leaves the in-progress set. The
+            # 2026-08-23 mainnet bid sat in this state for twelve days.
+            spend_txid = None
+            spend_rec = getattr(bid, "xmr_a_lock_spend_tx", None)
+            if spend_rec is not None and getattr(spend_rec, "txid", None):
+                spend_txid = spend_rec.txid
+            elif xmr_swap.a_lock_spend_tx_id:
+                spend_txid = xmr_swap.a_lock_spend_tx_id
+            if spend_txid:
+                reverse_bid: bool = self.is_reverse_ads_bid(
+                    offer.coin_from, offer.coin_to
+                )
+                was_received: bool = (
+                    bid.was_sent if reverse_bid else bid.was_received
+                )
+                coin_from = Coins(offer.coin_to if reverse_bid else offer.coin_from)
+                confirmations = self.pwndaTxConfirmations(
+                    self.ci(coin_from), spend_txid
+                )
+                if confirmations is not None and confirmations >= 1:
+                    if was_received:
+                        # The other side redeemed A; our completion is the
+                        # chain-B redeem, which the state machine owns. Not
+                        # automated here -- say so rather than guess.
+                        return {
+                            "recovered": False,
+                            "state": state_before,
+                            "reason": (
+                                "The counterparty's claim on chain A is confirmed; "
+                                "this side completes on chain B and is not settled "
+                                "automatically."
+                            ),
+                        }
+                    bid.setState(BidStates.XMR_SWAP_SCRIPT_TX_REDEEMED)
+                    if bid.xmr_a_lock_tx:
+                        bid.xmr_a_lock_tx.setState(TxStates.TX_REDEEMED)
+                    self.logBidEvent(
+                        bid.bid_id,
+                        EventLogTypes.LOCK_TX_A_SPEND_TX_SEEN,
+                        f"PWNDA-PATCH-27: chain-A redeem {spend_txid.hex()} has "
+                        f"{confirmations} confirmation(s); settling a bid parked in "
+                        f"{state_before}.",
+                        cursor,
+                    )
+                    bid.setState(BidStates.SWAP_COMPLETED)
+                    self.deactivateBid(cursor, offer, bid)
+                    self.saveBidInSession(bid_id, bid, cursor, xmr_swap)
+                    self.commitDB()
+                    try:
+                        self.notify(NT.SWAP_COMPLETED, {"bid_id": bid_id.hex()})
+                    except Exception as ex:
+                        self.log.warning(
+                            f"Failed to send swap completion notification: {ex}"
+                        )
+                    self.log.info(
+                        f"PWNDA-PATCH-27: settled bid {self.log.id(bid_id)} "
+                        f"(was {state_before}): chain-A redeem {spend_txid.hex()} "
+                        f"confirmed x{confirmations}."
+                    )
+                    return {
+                        "recovered": True,
+                        "settled": True,
+                        "state_before": state_before,
+                        "state": strBidState(bid.state),
+                        "confirmations": confirmations,
+                        "txid": spend_txid.hex(),
+                    }
             # Gate 3 -- nothing to publish if the spend tx was never built.
             if not xmr_swap.a_lock_spend_tx:
