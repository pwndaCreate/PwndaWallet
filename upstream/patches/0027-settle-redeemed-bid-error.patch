@@ -7746,6 +7822,32 @@
         finally:
             self.closeDB(cursor, commit=False)
 
+    def pwndaTxConfirmations(self, ci, txid: bytes) -> Optional[int]:
+        # PWNDA-PATCH-27: how many confirmations chain A gives a transaction,
+        # or None when the question cannot be answered -- and None means "do
+        # not settle", never "assume confirmed". Electrum mode asks the backend
+        # (verbose blockchain.transaction.get carries `confirmations`); RPC
+        # mode asks the node, then the wallet (the redeem is our own wallet's
+        # transaction, so gettransaction answers even without txindex).
+        try:
+            if hasattr(ci, "useBackend") and ci.useBackend():
+                backend = ci.getBackend()
+                info = backend.getTransaction(txid.hex()) if backend else None
+                if isinstance(info, dict):
+                    return int(info.get("confirmations", 0) or 0)
+                return None
+            try:
+                info = ci.rpc("getrawtransaction", [txid.hex(), True])
+            except Exception:
+                info = ci.rpc_wallet("gettransaction", [txid.hex()])
+            if isinstance(info, dict):
+                return int(info.get("confirmations", 0) or 0)
+        except Exception as e:
+            self.log.debug(
+                f"PWNDA-PATCH-27: could not read confirmations for {txid.hex()}: {e}"
+            )
+        return None
+
     def timeoutBid(self, bid_id: bytes, cursor=None) -> None:
         self.log.info(f"Bid {self.log.id(bid_id)} timed-out")
         self.deactivateBidForReason(bid_id, BidStates.SWAP_TIMEDOUT, cursor=cursor)
