+def _pwnda_scriptless_balances(self, coin_from: Coins, coin_to: Coins):
+    """PWNDA-PATCH-22 (defect D-7): balances of every scriptless leg, per node.
+
+    Returns {(node_id, coin): int} in the coin's smallest unit, or None when no
+    leg of this swap is scriptless (a scripted<->scripted pair, where the
+    existing `gettransaction` checks already cover both sides).
+
+    The shared ADS helpers verified settlement ONLY through the SCRIPTED coin's
+    `gettransaction`. For the scriptless coin they ran `pass`; for every
+    reverse bid they returned before reaching any check; and the swipe-refund
+    path had no verification block at all. So a partial settlement, or coins
+    stranded in the wrong wallet, read as a fully green matrix run -- on the
+    exact leg that has no script to reclaim from.
+    """
+    swap_clients = self.swap_clients
+    scriptless = swap_clients[0].scriptless_coins
+    out = {}
+    for coin in (coin_from, coin_to):
+        if coin not in scriptless:
+            continue
+        for node_id in (0, 1):
+            try:
+                ci = swap_clients[node_id].ci(coin)
+                out[(node_id, coin)] = ci.make_int(
+                    ci.getWalletInfo().get("balance", 0)
+                )
+            except Exception as e:  # a node that does not hold this coin
+                logging.info(f"D-7 baseline: {coin.name} node {node_id}: {e}")
+    return out or None
+
+
+def _pwnda_assert_scriptless_settled(self, coin_from, coin_to, before):
+    """PWNDA-PATCH-22 (defect D-7), success side: the scriptless leg moved.
+
+    Deliberately weak in form and strong in placement: it does not predict
+    WHICH node receives (that differs between forward and reverse bids), only
+    that the coins are no longer where they started. A stranded or partially
+    settled leg fails it; a completed one cannot. A missing baseline is a
+    FAILURE, not a skip -- otherwise this degrades into the `pass` it replaces.
+    """
+    if before is None:
+        return  # genuinely no scriptless leg in this pair
+    swap_clients = self.swap_clients
+    moved = set()
+    for (node_id, coin), was in before.items():
+        try:
+            ci = swap_clients[node_id].ci(coin)
+            now = ci.make_int(ci.getWalletInfo().get("balance", 0))
+        except Exception as e:
+            logging.info(f"D-7 settle read: {coin.name} node {node_id}: {e}")
+            continue
+        if now != was:
+            moved.add(coin)
+        logging.info(
+            f"D-7 {coin.name} node {node_id}: {was} -> {now} (delta {now - was})"
+        )
+    for coin in {c for (_n, c) in before}:
+        assert coin in moved, (
+            f"{coin.name} is the SCRIPTLESS leg of this swap and no node's "
+            f"balance changed at all. The bid reached its terminal state, so "
+            f"the state machine believes it settled -- but the coins did not "
+            f"move. This is exactly the stranded/partial settlement that read "
+            f"as a green run before defect D-7 was fixed."
+        )
+
+
+def _pwnda_assert_scriptless_refunded(self, coin_from, coin_to, before):
+    """PWNDA-PATCH-22 (defect D-7), refund side: the coins came BACK.
+
+    The success-path assertion is WRONG here: on a refund the coins return to
+    whoever locked them, so "some balance changed" would be satisfied by the
+    very failure that matters -- coins locked and never reclaimed.
+
+    So this asserts recovery instead: the TOTAL held across both nodes must be
+    within a fee of the pre-swap total. It does not care which node ends up
+    holding them, because a refund and a swipe-refund put them in different
+    places and both are legitimate outcomes of the paths that call this.
+    """
+    if before is None:
+        return
+    swap_clients = self.swap_clients
+    for coin in {c for (_n, c) in before}:
+        was_total = sum(v for (n, c), v in before.items() if c == coin)
+        now_total = 0
+        read_any = False
+        for (node_id, c) in before:
+            if c != coin:
+                continue
+            try:
+                ci = swap_clients[node_id].ci(coin)
+                now_total += ci.make_int(ci.getWalletInfo().get("balance", 0))
+                read_any = True
+            except Exception as e:
+                logging.info(f"D-7 refund read: {coin.name} node {node_id}: {e}")
+        assert read_any, (
+            f"could not read {coin.name} balances after the refund, so this "
+            f"check answered nothing"
+        )
+        logging.info(
+            f"D-7 refund {coin.name}: total {was_total} -> {now_total} "
+            f"(delta {now_total - was_total}, tolerance {self.max_fee})"
+        )
+        assert was_total - now_total <= self.max_fee, (
+            f"{coin.name} is the SCRIPTLESS leg and {was_total - now_total} "
+            f"(more than one fee) went missing across BOTH wallets during a "
+            f"refund. The bid reached its terminal refunded state, so the "
+            f"state machine believes the coins came back -- they did not. "
+            f"Stranded scriptless funds are the failure this path exists to "
+            f"catch, and it could not see them before defect D-7 was fixed."
+        )
+
+
