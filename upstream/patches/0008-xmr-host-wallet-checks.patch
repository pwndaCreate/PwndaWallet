+    def _confirmMainWalletIdentity(self) -> None:
+        # PWNDA-PATCH-8 (revised): re-read the main wallet-rpc connection's live
+        # address and compare it to the identity confirmed earlier by openWallet's
+        # _external_main_wallet branch, above. Raises TemporaryError on ANY
+        # mismatch, INCLUDING "nothing was ever cached" -- fails closed. A no-op
+        # when _external_main_wallet is False: only a host-managed main wallet
+        # can be switched out from under this connection by a party other than
+        # this swap engine (the host); an upstream-shape deployment (main wallet
+        # seed-derived, engine-exclusive) has no such actor.
+        #
+        # WHY THIS EXISTS SEPARATELY FROM openWallet's OWN cache check, above:
+        # openWallet's _external_main_wallet branch confirms and caches ONLY the
+        # FIRST time it is called (self._cached_main_wallet_address is None) and
+        # returns unconditionally on every call after that -- it never re-reads
+        # or re-compares once cached (see the comment there: "the engine only
+        # CONFIRMS... and caches it", once). So a caller like withdrawCoin, which
+        # calls openWallet() at its own top expecting that to mean "verified",
+        # gets nothing of the sort on the second and every later call. Call this
+        # method immediately before EVERY self.rpc_wallet("transfer"/"sweep_all",
+        # ...) call reachable on the main wallet-rpc connection while
+        # _external_main_wallet may be set -- not just from publishBLockTx. The
+        # original PWNDA-PATCH-8 guarded publishBLockTx alone and missed that
+        # withdrawCoin's two fund-moving calls share the exact same connection
+        # and the exact same race -- see the 2026-09-03 log.md entry
+        # ("xmr.py::withdrawCoin has no PATCH-8 drift guard") this revision
+        # closes. ZanoInterface's own PATCH-17 guard (interface/zano/zano.py)
+        # was modeled on this method's original, publishBLockTx-only form, and
+        # had the identical withdrawCoin gap found and fixed first, the same day
+        # -- this revision brings the interface it was copied from back in line.
+        if not self._external_main_wallet:
+            return
+        try:
+            open_wallet_addr = self.rpc_wallet("get_address")["address"]
+        except Exception:
+            open_wallet_addr = "UNKNOWN"
+        if open_wallet_addr != self._cached_main_wallet_address:
+            raise TemporaryError(
+                f"main wallet-rpc connection reports {open_wallet_addr}, expected "
+                f"confirmed identity {self._cached_main_wallet_address}; "
+                f"refusing to send"
+            )
+
     def _openWallet(self, filename):
