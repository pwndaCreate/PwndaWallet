+    def _confirmMainWalletIdentity(self) -> None:
+        # PWNDA-PATCH-17 (revised): re-read the main wallet-rpc connection's live
+        # address and compare it to the identity confirmed earlier by
+        # initialiseWallet's _external_main_wallet branch, above. Raises
+        # TemporaryError on ANY mismatch, INCLUDING "nothing was ever cached"
+        # (None) -- fails closed, exactly as PWNDA-PATCH-8's xmr.py guard does for
+        # XMRInterface. No-op when _external_main_wallet is False: only a
+        # host-managed main wallet can be switched out from under this connection
+        # by a party other than this swap engine; a REU26-shape deployment (main
+        # wallet seed-derived, engine-exclusive) has no such actor.
+        #
+        # Call this immediately before EVERY self.rpc_wallet("transfer", ...) (or
+        # other spend) call reachable on the main wallet-rpc connection while
+        # _external_main_wallet may be set -- not just from publishBLockTx. The
+        # first version of this patch guarded publishBLockTx alone and missed
+        # that withdrawCoin's two transfer sites share the exact same connection
+        # and the exact same race, and withdrawCoin is reachable from the webview
+        # UI and the JSON-RPC API, not only from the swap engine -- see the
+        # 2026-09-03 log.md follow-up entry ("PATCH-17 coverage gap").
+        if not self._external_main_wallet:
+            return
+        try:
+            open_wallet_addr = self.rpc_wallet("getaddress")["address"]
+        except Exception:
+            open_wallet_addr = "UNKNOWN"
+        if open_wallet_addr != self._cached_main_wallet_address:
+            raise TemporaryError(
+                f"main wallet-rpc connection reports {open_wallet_addr}, expected "
+                f"confirmed identity {self._cached_main_wallet_address}; "
+                f"refusing to send"
+            )
+
