+                # _destScriptForAddress is the helper that already does exactly
+                # that for the send path, and was simply not used here.
+                # Verified against Fulcrum's own blockchain.address.get_scripthash
+                # for P2PKH, P2SH20 and P2SH32.
+                scripthash = sha256(self._destScriptForAddress(address))[::-1].hex()
                 wm.importWatchOnlyAddress(
                     self.coin_type(),
                     address,
@@ -377,6 +407,22 @@ class BCHInterface(BTCInterface):
             return CScript([OP_HASH256, script_hash, OP_EQUAL])
 
     def withdrawCoin(self, value: float, addr_to: str, subfee: bool):
+        if self.useBackend():
+            # PWNDA-PATCH-23: build and sign through BCH's OWN paths --
+            # createRawFundedTransaction (cashaddr funding) and signTxWithWallet
+            # (FORKID sighash) -- rather than letting this fall through to a
+            # sendtoaddress RPC that electrum mode cannot answer.  Deliberately
+            # not delegating to btc.py's electrum withdraw: that one is
+            # segwit-oriented and would build a transaction BCH will not accept.
+            #
+            # This is also the path the sidecar interface fee collects on
+            # (js_bids -> withdrawCoin), so a BCH-leg fee sweep depends on it.
+            tx_hex = self.createRawFundedTransaction(
+                addr_to, self.make_int(value), sub_fee=subfee
+            )
+            signed_tx = self.signTxWithWallet(bytes.fromhex(tx_hex))
+            return self._backend.broadcastTransaction(signed_tx.hex())
+
         params = [addr_to, value, "", "", subfee, 0, False]
         return self.rpc_wallet("sendtoaddress", params)
 
@@ -402,6 +448,31 @@ class BCHInterface(BTCInterface):
         lock_tx_vout: int,
         script_pk: bytes,
     ) -> (int, int):
+        if self.useBackend():
+            # PWNDA-PATCH-23: gettxout is a NODE rpc (not rpc_wallet), so it is
+            # unavailable in electrum mode.  Fetch the raw lock tx from the
+            # backend and locate the output by its scriptPubKey instead of
+            # trusting the caller's vout index -- findOutput is what the rest of
+            # this interface already uses for that.
+            locked_n = None
+            actual_value = None
+            tx_hex = self.getBackend().getTransactionRaw(chain_b_lock_txid.hex())
+            if tx_hex:
+                lock_tx = self.loadTx(bytes.fromhex(tx_hex))
+                locked_n = findOutput(lock_tx, script_pk)
+                if locked_n is not None:
+                    actual_value = lock_tx.vout[locked_n].nValue
+                else:
+                    self._log.error(
+                        f"getBLockTxo: Output not found in tx {self._log.id(chain_b_lock_txid)}, "
+                        f"script_pk={script_pk.hex()}, num_outputs={len(lock_tx.vout)}"
+                    )
+            else:
+                self._log.warning(
+                    f"getBLockTxo: Failed to fetch tx {self._log.id(chain_b_lock_txid)} from backend"
+                )
+            return locked_n, actual_value
+
         txout = self.rpc("gettxout", [chain_b_lock_txid.hex(), lock_tx_vout, True])
         actual_value = self.make_int(txout["value"])
         return lock_tx_vout, actual_value
@@ -599,6 +670,17 @@ class BCHInterface(BTCInterface):
         )
 
     def getSpendableBalance(self) -> int:
+        if self.useBackend():
+            # PWNDA-PATCH-23: BCHInterface OVERRIDES this method, so it did not
+            # inherit BTCInterface's electrum branch -- the override reached the
+            # rpc_wallet call below in electrum mode, where there is no RPC node
+            # to answer it.  Observed live as a "Connection refused, method:
+            # getbalance" every 10 seconds.  Same shape as btc.py's own branch.
+            cached = getattr(self, "_cached_wallet_info", None)
+            if cached is not None:
+                return self.make_int(cached.get("balance", 0))
+            return 0
+
         return self.make_int(self.rpc_wallet("getbalance", ["*", 1, False]))
 
     def getScriptDest(self, script):
