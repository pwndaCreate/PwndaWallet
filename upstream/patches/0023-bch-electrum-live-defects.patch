-                script = self.getScriptForPubkeyHash(self.decodeAddress(address))
-                scripthash = sha256(bytes(script))[::-1].hex()
+                # own scripthash and hand it over explicitly instead of
+                # falling through into that broken path.
+                #
+                # PWNDA-PATCH-23: this computed a P2PKH scripthash
+                # UNCONDITIONALLY.  Swap lock addresses are P2SH, so every lock
+                # was watched at the scripthash of a script it does not have:
+                # the subscription never fires, the funding tx is never seen,
+                # and the swap stalls with the coins already sent.  Dispatch on
