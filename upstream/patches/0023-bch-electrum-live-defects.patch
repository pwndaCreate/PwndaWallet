     def getUnspentsByAddr(self):
         unspent_addr = dict()
+        if self.useBackend():
+            # PWNDA-PATCH-23: as getSpendableBalance above -- an override that
+            # lost BTCInterface's electrum branch. Read balances per watched
+            # address from the backend instead of listunspent, which needs a
+            # loaded RPC wallet.
+            wm = self.getWalletManager()
+            if wm:
+                addresses = wm.getAllAddresses(self.coin_type())
+                if addresses:
+                    return self._backend.getBalance(addresses)
+            return unspent_addr
+
         unspent = self.rpc_wallet("listunspent")
         for u in unspent:
             if u.get("spendable", False) is False:
@@ -233,10 +245,18 @@ class BCHInterface(BTCInterface):
         address = self.encodeScriptDest(lock_tx_dest)
 
         if not self.isAddressMine(address, or_watch_only=True):
-            # Expects P2WSH nested in BIP16_P2SH
-            self.rpc_wallet(
-                "importaddress", [lock_tx_dest.hex(), "bid lock", False, True]
-            )
+            if self.useBackend():
+                # PWNDA-PATCH-23: isAddressMine IS backend-aware, so in electrum
+                # mode this branch is reached normally rather than being dead --
+                # and it called rpc_wallet, which electrum mode cannot serve.
+                # Route it through importWatchOnlyAddress, which registers the
+                # scripthash subscription the lock actually needs.
+                self.importWatchOnlyAddress(address, "bid lock")
+            else:
+                # Expects P2WSH nested in BIP16_P2SH
+                self.rpc_wallet(
+                    "importaddress", [lock_tx_dest.hex(), "bid lock", False, True]
+                )
 
         return address
 
@@ -252,10 +272,20 @@ class BCHInterface(BTCInterface):
                 # cashaddr string; passed no scripthash, it would silently
                 # store "" and break the electrum scripthash subscription
                 # this whole light-mode path exists for.  Compute BCH's
-                # own P2PKH scripthash and hand it over explicitly instead
