+# -*- coding: utf-8 -*-
+
+# Copyright (c) 2026 The Basicswap developers
+# Distributed under the MIT software license, see the accompanying
+# file LICENSE or http://www.opensource.org/licenses/mit-license.php.
+
+# PWNDA-PATCH-13: Zephyr Protocol interface, on the per-coin-folder layout.
+# Zephyr is a Monero fork (base v2.3.0) with a Djed-style stablecoin overlay
+# on top -- everything a swap needs (key-share split, DLEq, address
+# encoding, lock-tx publishing) is inherited unchanged from XMRInterface,
+# exactly like WOWInterface. The two Zephyr-specific adaptations both live
+# in the *wallet-RPC* layer, not the swap protocol -- see REU26's
+# zephyr-testnet/RQ2-RPC-DIFF.md:
+#   - get_balance returns {"balances": [{"asset_type": "ZPH", balance, ...},
+#     ...]}, not Monero's flat {balance, unlocked_balance}. Flattened onto
+#     the top-level keys XMRInterface's inherited methods actually read.
+#   - transfer / transfer_split require source_asset/destination_asset. A
+#     swap only ever moves base ZEPH (conversions are out of the swap
+#     path), so both default to "ZPH".
+# Both are handled by wrapping self.rpc_wallet in __init__, so every
+# inherited XMRInterface method keeps working unmodified.
+#
+# REU26 provenance: work/forks/basicswap-zephyr/basicswap/interface/
+# zephyr.py (the 106-line interface, proven through the 8-test ZEPH swap
+# matrix -- G:\REU26\zephyr-testnet\test-evidence-zeph*), re-pathed onto
+# dev's post-#532 per-coin-folder layout per ResearchWiki/synthesis/
+# zeph-coin-add-dev-restructure-replan.md Phase 1 step 3. coin_type,
+# ticker_str, COIN, exp, __init__, _wrap_rpc_wallet are ported verbatim
+# (import lines re-pathed only, per the replan). depth_spendable() and the
+# openWallet override both diverge from REU26 -- see the comments at each.
+
+from basicswap.chainparams import Coins
+from basicswap.interface.zephyr.chainparams import ZEPH_COIN
+from basicswap.interface.xmr.xmr import XMRInterface
+
+
+class ZEPHInterface(XMRInterface):
+
+    @staticmethod
+    def coin_type():
+        return Coins.ZEPH
+
+    @staticmethod
+    def ticker_str() -> int:
+        return Coins.ZEPH.name
+
+    @staticmethod
+    def COIN():
+        return ZEPH_COIN
+
+    @staticmethod
+    def exp() -> int:
+        return 12
+
+    @staticmethod
+    def depth_spendable() -> int:
+        # PWNDA-PATCH-13 divergence from REU26: REU26's zephyr.py returns 10
+        # here, matched to Monero's own value with the stated reasoning
+        # "same wall-clock maturity as Monero's 2-minute blocks". That
+        # reasoning is sound for a coin whose OWN wallet balance the engine
+        # must trust unescorted -- but Grove only ever runs ZEPH as the
+        # follower/chain-B leg of a swap (grove-expansion-master-plan.md
+        # Phase C unit C-RZ), where the swap protocol's own
+        # `blocks_confirmed` coin-settings knob (set to 3 in this patch's
+        # core.py, matching XMRPrepare's own default) is ALREADY the
+        # binding lock-confirmation gate. depth_spendable's remaining job
+        # here is only "how many confirmations before the engine's wallet
+        # balance arithmetic treats a received output as spendable" -- the
+        # same question WOW answers with 4 despite Monero itself answering
+        # 10, i.e. this value is meant to be retuned per fork, not
+        # inherited. REU26's own comment on this exact method warns against
+        # exactly what its own chosen value does: "do not blindly inherit
+        # Monero's value - retune it for THIS fork's block time." Zephyr's
+        # 2-minute blocks and materially smaller hashrate than Monero argue
+        # for staying above WOW's 4 rather than matching it, so this project
+        # sets 3: below Monero's 10 (nothing here needs Monero's threat
+        # model, since the swap-lock confirmation gate is separate and
+        # already binding) but not as low as WOW's 4, given Zephyr's
+        # thinner hashrate. Documented as a genuine engineering choice, not
+        # a copy of either source.
+        return 3
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.rpc_wallet = self._wrap_rpc_wallet(self.rpc_wallet)
+
+    @staticmethod
+    def _wrap_rpc_wallet(inner):
+        # Ported verbatim from REU26's zephyr.py (_wrap_rpc_wallet) -- the
+        # ZPH-asset-field injection and get_balance flattening described in
+        # the module docstring above.
+        def rpc_wallet(method, params=None, **kwargs):
+            if method in ("transfer", "transfer_split"):
+                params = dict(params or {})
+                params.setdefault("source_asset", "ZPH")
+                params.setdefault("destination_asset", "ZPH")
+            rv = inner(method, params, **kwargs)
+            if method == "get_balance" and isinstance(rv, dict):
+                zb = None
+                for b in rv.get("balances", []) or []:
+                    if b.get("asset_type") == "ZPH":
+                        zb = b
+                        break
+                if zb is not None:
+                    rv["balance"] = zb.get("balance", 0)
+                    rv["unlocked_balance"] = zb.get("unlocked_balance", 0)
+                    rv["blocks_to_unlock"] = zb.get("blocks_to_unlock", 0)
+                    rv["multisig_import_needed"] = zb.get(
+                        "multisig_import_needed", False
+                    )
+                # Guarantee Monero-shaped keys even for empty/sparse
+                # responses (a fresh Zephyr wallet's get_balance omits
+                # them), so inherited XMRInterface code works.
+                rv.setdefault("balance", rv.get("unlocked_balance", 0))
+                rv.setdefault("unlocked_balance", 0)
+                rv.setdefault("blocks_to_unlock", 0)
+                rv.setdefault("multisig_import_needed", False)
+            return rv
+
+        return rpc_wallet
+
+    # PWNDA-PATCH-13 divergence from REU26: REU26's zephyr.py overrides the
+    # PUBLIC `openWallet(self, filename)`. On the current dev base this
+    # patch series targets (upstream/basicswap/basicswap/interface/xmr/
+    # xmr.py), XMRInterface.openWallet is no longer the whole story: it
+    # first short-circuits via a cached main-wallet address
+    # (self._cached_main_wallet_address) before making any RPC call at all,
+    # and only then delegates the actual open/retry work to a separate
+    # `_openWallet`. WOWInterface already follows this exact split --
+    # wow.py overrides `_openWallet`, not `openWallet` (its own comment:
+    # "below only needed until wow is rebased ..."). Overriding the public
+    # method the way REU26 did would silently drop that address-cache fast
+    # path for every ZEPH wallet open (every call would re-hit RPC even
+    # when the cached address already matches). So this override targets
+    # `_openWallet` instead, through the same extension point WOW uses,
+    # keeping REU26's proven retry body unchanged: open; on "no connection
+    # to daemon" allow startup against a busy daemon; on any other failure,
+    # store+close then reopen once.
+    def _openWallet(self, filename):
+        params = {"filename": filename}
+        if self._wallet_password is not None:
+            params["password"] = self._wallet_password
+        try:
+            self.rpc_wallet("open_wallet", params)
+        except Exception as e:
+            if "no connection to daemon" in str(e):
+                self._log.debug(f"{self.coin_name()} {e}")
+                return  # allow startup with a busy daemon
+            try:
+                self.rpc_wallet("store")
+                self.rpc_wallet("close_wallet")
+            except Exception:
+                pass
+            self.rpc_wallet("open_wallet", params)
+
