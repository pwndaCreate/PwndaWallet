@@ -0,0 +1,223 @@
+# -*- coding: utf-8 -*-
+
+# Copyright (c) 2026 The Basicswap developers
+# Distributed under the MIT software license, see the accompanying
+# file LICENSE or http://www.opensource.org/licenses/mit-license.php.
+
+# PWNDA-PATCH-13: Zephyr Protocol provisioning module, on the per-coin-folder
+# layout (basicswap/interface/prepare_util.py::CoinPrepareModule contract).
+#
+# Grove itself never runs tryPrepareCore for zephyr: ZEPH always runs as a
+# REMOTE/host wallet (grove-expansion-master-plan.md Phase C unit C-RZ:
+# ZphLease, "bootstrap daemon = pool head"), Grove's actual binary
+# provisioning is Phase A unit A2's Get-SwapCoinBinaries.ps1 pin (hash-
+# verified, independent of this module), and basicswap-prepare is always
+# invoked --nocores for zephyr. downloadCore/verifyCoreSignature/extractCore
+# below are still real, working implementations rather than raise-on-call
+# placeholders: CoinPrepareModule is a contract every registered coin
+# fulfils (WOW and XMR both carry working versions in this same tree), and
+# leaving ZEPH's unimplemented would make it the one coin that silently
+# breaks if --nocores were ever omitted by mistake, instead of behaving the
+# way the framework expects every coin to. They are modelled on REU26's
+# proven design, cited per-method below.
+#
+# REU26 provenance (primary, authoritative for THIS file's shape):
+# ResearchWiki/synthesis/zeph-coin-add-dev-restructure-replan.md Phase 1
+# step 4. Note this deliberately does NOT match the OLDER flat-fork
+# prepare.py block (zephyr-testnet/patches/
+# basicswap-prepare-zephyr-coin-add.patch), which pointed downloadCore at a
+# REU26-hosted MIRROR binary ("Path B": zephyr-cli-linux-v{V}-reu26.zip on
+# Notsosmartt-cmd/zephyr-basicswap). The replan's per-coin-folder design
+# instead downloads Zephyr's own OFFICIAL release ("Path A":
+# ZephyrProtocol/zephyr) and only borrows the REU26-hosted SHA256SUMS for
+# the hash, since Zephyr's official release publishes no hash file of its
+# own at all -- ResearchWiki/synthesis/zeph-basicswap-pr-paths.md documents
+# that gap exhaustively (all 69 assets across all 15 releases checked).
+# Followed here as the replan specifies.
+
+import os
+import zipfile
+
+from basicswap.interface.zephyr.chainparams import params
+from basicswap.interface.xmr.core import XMRPrepare
+from basicswap.interface.prepare_util import PrepareContext, setBinExecPermissions
+
+ZEPHYR_VERSION = os.getenv("ZEPHYR_VERSION", "2.3.0")
+ZEPHYR_VERSION_TAG = os.getenv("ZEPHYR_VERSION_TAG", "")
+
+# No real signer: verifyCoreSignature() below is a genuine no-op (Zephyr's
+# release publishes no signature at all -- see the provenance note above),
+# so ensurePubkey/self.signers is never consulted on this path. Kept as an
+# empty dict, matching the CoinPrepareModule contract's expected shape,
+# rather than omitted.
+zephyr_signers = {}
+
+ZEPH_RPC_HOST = os.getenv("ZEPH_RPC_HOST", "127.0.0.1")
+ZEPH_RPC_PORT = int(os.getenv("ZEPH_RPC_PORT", 17767))
+ZEPH_ZMQ_PORT = int(os.getenv("ZEPH_ZMQ_PORT", 17769))
+ZEPH_WALLET_RPC_PORT = int(os.getenv("ZEPH_WALLET_RPC_PORT", 17768))
+ZEPH_WALLET_RPC_HOST = os.getenv("ZEPH_WALLET_RPC_HOST", "127.0.0.1")
+ZEPH_WALLET_RPC_USER = os.getenv("ZEPH_WALLET_RPC_USER", "zeph_wallet_user")
+ZEPH_WALLET_RPC_PWD = os.getenv("ZEPH_WALLET_RPC_PWD", "zeph_wallet_pwd")
+ZEPH_RPC_USER = os.getenv("ZEPH_RPC_USER", "")
+ZEPH_RPC_PWD = os.getenv("ZEPH_RPC_PWD", "")
+DEFAULT_ZEPH_RESTORE_HEIGHT = int(os.getenv("DEFAULT_ZEPH_RESTORE_HEIGHT", 0))
+
+
+class ZEPHPrepare(XMRPrepare):
+    def getConfigSegment(self, ctx: PrepareContext) -> dict:
+        datadir = os.getenv("ZEPH_DATA_DIR", os.path.join(ctx.data_dir, self.name))
+        config = {
+            "connection_type": "rpc",
+            # PWNDA-PATCH-13 divergence from REU26: REU26's own core.py (and
+            # every stock xmr-family coin in this tree --
+            # WOWPrepare.getConfigSegment, XMRPrepare.getConfigSegment)
+            # routes these two flags through ctx.should_manage_daemon(...),
+            # so basicswap-prepare's --manage-daemons flag decides at
+            # provisioning time. Grove never lets basicswap-prepare manage a
+            # ZEPH daemon or wallet at all -- ZEPH is always a REMOTE host
+            # wallet the Rust sidecar leases against a pool node (see the
+            # module docstring, Phase C unit C-RZ) -- so both flags are
+            # hardcoded False here rather than left as a toggle nothing in
+            # Grove's deployment ever sets True.
+            "manage_daemon": False,
+            "manage_wallet_daemon": False,
+            "rpcport": ZEPH_RPC_PORT + ctx.port_offset,
+            "zmqport": ZEPH_ZMQ_PORT + ctx.port_offset,
+            "walletrpcport": ZEPH_WALLET_RPC_PORT + ctx.port_offset,
+            "rpchost": ZEPH_RPC_HOST,
+            "walletrpchost": ZEPH_WALLET_RPC_HOST,
+            "walletrpcuser": ZEPH_WALLET_RPC_USER,
+            "walletrpcpassword": ZEPH_WALLET_RPC_PWD,
+            "walletsdir": os.getenv("ZEPH_WALLETS_DIR", datadir),
+            "datadir": datadir,
+            "bindir": os.path.join(ctx.bin_dir, self.name),
+            "restore_height": DEFAULT_ZEPH_RESTORE_HEIGHT,
+            "blocks_confirmed": 3,
+            "rpctimeout": 60,
+            "walletrpctimeout": 120,
+            "walletrpctimeoutlong": 300,
+            "core_version_no": self.version + self.version_tag,
+            "core_type_group": "xmr",
+        }
+
+        if self.rpc_user != "":
+            config["rpcuser"] = self.rpc_user
+            config["rpcpassword"] = self.rpc_password
+
+        return config
+
+    def downloadCore(
+        self,
+        ctx: PrepareContext,
+        bin_dir: str,
+        signing_key_name: str,
+        extra_opts: dict,
+    ) -> tuple:
+        # Zephyr's official release asset naming (verified against the real
+        # release page, linux asset -- ResearchWiki/synthesis/
+        # zeph-basicswap-pr-paths.md A4). win/osx cases mirror that same
+        # "zephyr-cli-<os>-v<version>.zip" convention rather than a second
+        # independently-verified asset; Grove is Windows-only in practice
+        # and never exercises this method at all (see the module
+        # docstring), so this is the correct shape rather than a verified
+        # cross-platform fact.
+        os_name = "linux"
+        if "osx" in ctx.bin_arch:
+            os_name = "mac"
+        elif "win32" in ctx.bin_arch or "win64" in ctx.bin_arch:
+            os_name = "win"
+
+        release_filename = f"zephyr-cli-{os_name}-v{self.version}.zip"
+        release_url = (
+            f"https://github.com/ZephyrProtocol/zephyr/releases/download/"
+            f"v{self.version}/{release_filename}"
+        )
+        release_path = os.path.join(bin_dir, release_filename)
+        ctx.download_release(release_url, release_path, extra_opts)
+
+        # Zephyr's own release has no hash file at all (see the module
+        # docstring), so the hash BasicSwap's always-runs verifyCoreHash
+        # step verifies against is REU26's community-hosted mirror of it,
+        # per the replan's Phase 1 step 4 -- not a Zephyr-published
+        # artifact.
+        assert_filename = f"zephyr-{self.version}-SHA256SUMS"
+        assert_url = (
+            f"https://raw.githubusercontent.com/Notsosmartt-cmd/"
+            f"zephyr-basicswap/main/{self.version}/SHA256SUMS"
+        )
+        assert_path = os.path.join(bin_dir, assert_filename)
+        if not os.path.exists(assert_path):
+            ctx.download_file(assert_url, assert_path)
+
+        return release_path, assert_path, None
+
+    def verifyCoreSignature(
+        self,
+        ctx: PrepareContext,
+        gpg,
+        release_path: str,
+        assert_path: str,
+        assert_sig_path: str,
+        signing_key_name: str,
+        extra_opts: dict,
+    ) -> None:
+        # No-op: this IS the hash-only path. verifyCoreHash (base class,
+        # never overridden here) already ran and raised if the release
+        # didn't match the SHA256SUMS entry; there is simply no signature to
+        # check on top of it, because Zephyr's release publishes none (see
+        # downloadCore above).
+        ctx.logger.info(
+            f"{self.name}: publishes no signature upstream; hash-only verification."
+        )
+
+    def extractCore(
+        self,
+        ctx: PrepareContext,
+        bin_dir: str,
+        release_path: str,
+        extra_opts: dict,
+    ) -> None:
+        # Zephyr ships a .zip on every platform, unlike monero/wownero (tar
+        # .bz2 on linux). The inherited XMRPrepare.extractCore delegates to
+        # extractCoreByBasename, which only takes the zip branch when
+        # ctx.bin_arch itself says win32/win64 -- it would wrongly try
+        # tarfile.open() on this archive on any other platform. Extract via
+        # zipfile unconditionally instead, matching entries by basename
+        # (archive member paths inside Zephyr's zip are not guaranteed
+        # flat-at-root across releases).
+        ctx.logger.info(
+            f"Extracting core {self.name} v{self.version}{self.version_tag}"
+        )
+        extract_core_overwrite = extra_opts.get("extract_core_overwrite", True)
+        bins = self.getExtractBins()
+
+        num_exist = sum(1 for b in bins if os.path.exists(os.path.join(bin_dir, b)))
+        if not extract_core_overwrite and num_exist == len(bins):
+            ctx.logger.info("Skipping extract, files exist.")
+            return
+
+        with zipfile.ZipFile(release_path) as fz:
+            namelist = fz.namelist()
+            for b in bins:
+                out_path = os.path.join(bin_dir, b)
+                if os.path.exists(out_path) and not extract_core_overwrite:
+                    continue
+                for entry in namelist:
+                    if entry == b or entry.endswith("/" + b):
+                        with open(out_path, "wb") as fout:
+                            fout.write(fz.read(entry))
+                        setBinExecPermissions(ctx, out_path)
+                        break
+
+
+prepare_module = ZEPHPrepare(
+    name=params["name"],
+    ticker=params["ticker"],
+    version=ZEPHYR_VERSION,
+    version_tag=ZEPHYR_VERSION_TAG,
+    signers=zephyr_signers,
+    rpc_user=ZEPH_RPC_USER,
+    rpc_password=ZEPH_RPC_PWD,
+)
