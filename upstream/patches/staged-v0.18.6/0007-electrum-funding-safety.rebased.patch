             ci = self.ci(coin_type)
             hrp = ci.chainparams_network().get("hrp", "bc")
 
+            # PWNDA-PATCH-7: a coin explicitly adopted at address_type "p2pkh"
+            # (PATCH-3/4) is non-bech32 BY DESIGN -- that is not "legacy funds
+            # needing consolidation", it is the wallet's normal, intentional
+            # shape. Only flag non-bech32 balances for a coin that is NOT
+            # configured that way (upstream's original case: stray funds on an
+            # address type this wallet never meant to use).
+            #
+            # Rebased onto v0.18.6 (2026-09-06): upstream rewrote this function
+            # to source legacy_addresses from getAllAddresses() and price them
+            # via backend.getBalance(), replacing the unspent_by_addr scan this
+            # patch originally hooked. The guard is orthogonal to that change,
+            # so it moves UP to an early return -- which also honours upstream's
+            # own "a wallet with none needs no electrum traffic at all" intent
+            # instead of computing a balance only to discard it.
+            if self._wallet_manager._pwndaAddressType(coin_type) == "p2pkh":
+                return {"has_legacy_funds": False}
+
             # Legacy addresses only enter the wallet through a full node wallet
             # migration.  Filter before querying, a wallet with none needs no
             # electrum traffic at all.
