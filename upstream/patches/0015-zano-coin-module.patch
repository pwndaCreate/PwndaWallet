+    def getNewRandomKey(self) -> bytes:
+        # Note: Returned bytes are in big endian order (same convention xmr.py uses).
+        return i2b(9 + secrets.randbelow(ed25519_l - 9))
+
+    def encodeKey(self, vk: bytes) -> str:
+        return vk[::-1].hex()
+
+    def decodeKey(self, k_hex: str) -> bytes:
+        return bytes.fromhex(k_hex)[::-1]
+
+    def getPubkey(self, privkey):
+        return ed25519_get_pubkey(privkey)
+
+    def getAddressFromKeys(self, key_view: bytes, key_spend: bytes) -> str:
+        pk_view = self.getPubkey(key_view)
+        pk_spend = self.getPubkey(key_spend)
+        return xmr_util.encode_address(pk_view, pk_spend, self._addr_prefix)
+
+    def verifyKey(self, k: int) -> bool:
+        i = b2i(k)
+        return i < ed25519_l and i > 8
+
+    def verifyPubkey(self, pubkey_bytes):
+        return verify_ed25519_point(pubkey_bytes)
+
+    def proveDLEAG(self, key: bytes) -> bytes:
+        privkey = PrivateKey(key)
+        return dleag_prove(privkey)
+
+    def verifyDLEAG(self, dleag_bytes: bytes) -> bool:
+        return dleag_verify(dleag_bytes)
+
+    def lengthDLEAG(self) -> int:
+        return dleag_proof_len()
+
+    def sumKeys(self, ka: bytes, kb: bytes) -> bytes:
+        return ed25519_scalar_add(ka, kb)
+
+    def sumPubkeys(self, Ka: bytes, Kb: bytes) -> bytes:
+        return ed25519_add(Ka, Kb)
+
+    def encodeSharedAddress(self, Kbv: bytes, Kbs: bytes) -> str:
+        return xmr_util.encode_address(Kbv, Kbs, self._addr_prefix)
+
+    # ------------------------------------------------------------------
+    # Chain-B lock tx: publish (leader side, PART/BTC-style leader paying INTO the Zano
+    # joint address), find (both sides watch for it), and spend (follower side sweeping
+    # the joint address out) -- the actual follower mechanic REU26 rung 2 drove by hand,
+    # now behind BasicSwap's abstractions.
+    # ------------------------------------------------------------------
+
+    def publishBLockTx(
+        self,
+        kbv: bytes,
+        Kbs: bytes,
+        output_amount: int,
+        feerate: int,
+        unlock_time: int = 0,
+    ) -> bytes:
+        with self._mx_wallet:
+            Kbv = self.getPubkey(kbv)
+            shared_addr: str = xmr_util.encode_address(Kbv, Kbs, self._addr_prefix)
+
+            params = {
+                "destinations": [{"amount": output_amount, "address": shared_addr}],
+                "fee": self.make_int(self.get_fee_rate()[0]),
+                "mixin": 0,
+                "payment_id": "",
+                "comment": "",
+            }
+            rv = self.rpc_wallet("transfer", params)
+            self._log.info(
+                "publishBLockTx {} to address_b58 {}".format(
+                    rv["tx_hash"], shared_addr
+                )
+            )
+            tx_hash: bytes = bytes.fromhex(rv["tx_hash"])
+            return tx_hash
+
+    def findTxB(
+        self,
+        kbv,
+        Kbs,
+        cb_swap_value: int,
+        cb_block_confirmed: int,
+        restore_height: int,
+        bid_sender: bool,
+        check_amount: bool = True,
+    ):
+        with self._mx_wallet:
+            Kbv = self.getPubkey(kbv)
+            address_b58 = xmr_util.encode_address(Kbv, Kbs, self._addr_prefix)
+
+            kbv_le = kbv[::-1]
+            params = {
+                "filename": address_b58,
+                "address": address_b58,
+                "viewkey": b2h(kbv_le),
+                "restore_height": restore_height,
+            }
+            # Re-runnable for a view-only open on this address (REU26 rung 2 ran this
+            # exact call shape live -- no spendkey means a watch-only wallet).
+            # "Re-runnable" is NOT "harmless": generate_from_keys replaces the target
+            # process's account and calls reset_history(), so it is only safe here
+            # because it runs on the SCRATCH connection, whose account is expected to be
+            # thrown away. See the __init__ note on why it must never touch rpc_wallet
+            # (createWallet now refuses outright if no scratch connection exists).
+            self.createWallet(params)
+            self._waitWalletRescanned(self.rpc_wallet_scratch)
+
+            # get_outputs is Zano's incoming_transfers equivalent (reshaped, per the
+            # mapping table): a flat list of UTXOs/STXOs rather than XMR's
+            # {transfers: [...]}.
+            #
+            # WARNING: get_outputs carries NO per-output "unlocked" flag and its
+            # 'spendable' field is NOT one (see _groupOutputsByTx). The spend-time lock
+            # has to come from the wallet's transfer history instead -- see
+            # _getTxUnlockTimes.
+            outs = self.rpc_wallet_scratch("get_outputs", {"output_type": "all"})
+            unlock_times = self._getTxUnlockTimes(self.rpc_wallet_scratch)
+            return self._matchLockTxOutputs(
+                outs.get("outputs", []), cb_swap_value, check_amount, unlock_times
+            )
+
+    def _getTxUnlockTimes(self, rpc, count: int = 1000):
+        """Map {tx_hash_hex: unlock_time} for every tx this wallet knows about.
+
+        [REU26 RUNG 6 REVIEW FIX - FUNDS LOSS] ZanoInterface had NO counterpart to
+        XMRInterface's unlock-time check. Zano transactions carry a spend-time lock in
+        `extra` -- either a tx-wide `etc_tx_details_unlock_time` (tag 14) or a
+        PER-OUTPUT `etc_tx_details_unlock_time2` array (tag 30),
+        currency_core/currency_basic.h:997-1013 -- and consensus only enforces it when
+        the referenced output is SPENT. A transaction that CREATES far-future-locked
+        outputs is therefore perfectly valid and mineable. Without this check a
+        malicious bidder could publish a chain-B lock whose joint-address outputs are
+        locked until a time of their choosing: the amount matches and the height is
+        non-zero, so the leader accepts it and releases chain A, and its own sweep then
+        fails forever on unlocked_balance.
+
+        The signal: get_recent_txs_and_info3 returns wallet_transfer_info.unlock_time,
+        which wallet2.cpp fills from
+        get_max_unlock_time_from_receive_indices(tx, employed_entries) -- i.e. the
+        MAXIMUM unlock time over exactly the outputs paid to THIS wallet, honouring both
+        the tx-wide tag and the per-output array. That is the precise quantity we need.
+
+        Returns None if the history could not be read, so callers can fail closed.
+        """
+        try:
+            rv = rpc(
+                "get_recent_txs_and_info3",
+                {
+                    "offset": 0,
+                    "count": count,
+                    "update_provision_info": False,
+                    "exclude_mining_txs": False,
+                    "exclude_unconfirmed": False,
+                    "order": "FROM_END_TO_BEGIN",
+                },
+            )
+        except Exception as e:
+            self._log.warning("ZANO get_recent_txs_and_info3 failed: {}".format(e))
+            return None
+        unlock_times = {}
+        for tx in rv.get("transfers", []):
+            tx_hash = tx.get("tx_hash")
+            if tx_hash:
+                unlock_times[tx_hash] = tx.get("unlock_time", 0)
+        total = rv.get("total_transfers", 0)
+        if total > count:
+            # The window did not cover the whole history; a caller that cannot find its
+            # txid in here must not assume "unlock_time 0", so signal "unknown" rather
+            # than a short map.
+            self._log.warning(
+                "ZANO wallet history has {} entries, more than the {} requested; "
+                "unlock-time check cannot be completed.".format(total, count)
+            )
+            return None
+        return unlock_times
+
+    def _daemonTxUnlockTime(self, txid: str):
+        """Independent, daemon-side answer to "does this tx set a spend-time lock?".
+
+        Fallback for when the wallet-side history (see _getTxUnlockTimes) is
+        unavailable, so a transient wallet-rpc problem cannot stall an otherwise healthy
+        swap while still refusing to accept an unverified lock. The daemon's
+        get_tx_details renders BOTH unlock-time extra variants with
+        type == "unlock_time", and apply_unlock_time only pushes the entry when at least
+        one destination actually carries a non-zero unlock time. So for a non-coinbase
+        tx, "an unlock_time extra entry is present" is exactly "this tx is spend-time
+        locked".
+
+        Returns 0 (no lock), 1 (locked -- the exact value is not needed, only the fact),
+        or None when the daemon could not answer.
+        """
+        try:
+            rv = self.rpc("get_tx_details", {"tx_hash": txid})
+        except Exception as e:
+            self._log.warning("ZANO get_tx_details failed for {}: {}".format(txid, e))
+            return None
+        tx_info = rv.get("tx_info")
+        if not isinstance(tx_info, dict) or "extra" not in tx_info:
+            return None
+        for entry in tx_info.get("extra") or []:
+            if entry.get("type") == "unlock_time":
+                self._log.warning(
+                    "ZANO tx {} carries an unlock_time extra entry: {}".format(
+                        txid, entry.get("short_view")
+                    )
+                )
+                return 1
+        return 0
+
+    @staticmethod
+    def _groupOutputsByTx(outputs):
+        """Sum a get_outputs list per producing transaction.
+
+        [REU26 RUNG 5-6 BUG -- the one that actually stopped the first end-to-end swap.]
+        Monero sends a destination amount as ONE output, so XMRInterface's findTxB can
+        compare a single incoming_transfers entry against cb_swap_value. Zano does NOT:
+        `transfer` still decomposes every destination (and the change) into classic
+        CryptoNote digit denominations. The lock is the SUM of a transaction's outputs
+        to the joint address, so group first.
+
+        NOTE on the per-output 'spendable' flag: it is NOT a coinage or unlock-time
+        signal. wallet_rpc_server.cpp sets it from transfer_details_base::is_spendable(),
+        a pure flag test with no WALLET_DEFAULT_TX_SPENDABLE_AGE component and no
+        unlock-time component. It is kept only as a wallet-local "this output is
+        blocked/reserved" hint, reported by _matchLockTxOutputs.
+        """
+        by_tx = {}
+        for out in outputs:
+            if not out.get("native_coin", True):
+                continue
+            txid = out.get("tx_id")
+            if not txid:
+                continue
+            e = by_tx.setdefault(
+                txid,
+                {
+                    "txid": txid,
+                    "amount": 0,
+                    "height": 0,
+                    "spendable": True,
+                    "n": 0,
+                    "any_unconfirmed": False,
+                },
+            )
+            e["amount"] += out.get("amount", 0)
+            e["n"] += 1
+            h = out.get("block_height", 0)
+            # Height of the lock = the block the tx landed in; every output of one tx
+            # shares it. The old code did max() then "if h == 0: height = 0", which was
+            # iteration-order dependent (a height-0 output only forced the group to 0
+            # when it happened to be processed last). Track "any output unconfirmed"
+            # explicitly instead.
+            if h == 0:
+                e["any_unconfirmed"] = True
+            else:
+                e["height"] = max(e["height"], h)
+            if not out.get("spendable", False) and not out.get("spent", False):
+                e["spendable"] = False
+        for e in by_tx.values():
+            if e["any_unconfirmed"]:
+                e["height"] = 0
+        return by_tx
+
+    def _matchLockTxOutputs(
+        self, outputs, cb_swap_value: int, check_amount: bool, unlock_times=None
+    ):
+        """Pick the chain-B lock tx out of the joint wallet's outputs.
+
+        Return values follow XMRInterface.findTxB's contract:
+          dict  - this IS the lock tx, and it is safe to act on (the leader may release
+                  chain A)
+          -1    - a tx that is protocol-INVALID (wrong amount, or spend-time locked).
+                  The caller turns this into EventLogTypes.LOCK_TX_B_INVALID, and a
+                  contract-chain leader refunds on it, so it must mean "definitely
+                  wrong", never "not ready yet".
+          None  - nothing conclusive seen yet; keep polling. Timing out here is safe:
+                  chain A is refunded rather than released.
+
+        [REU26 RUNG 9 REVIEW FIX -- THE -1 ACCUMULATOR] `rv` is function-scoped, so
+        before this fix a -1 recorded for SOME OTHER transaction in the joint wallet was
+        still returned after the REAL lock had been skipped for being unconfirmed. The
+        joint address is known to the counterparty before the lock confirms, so a
+        follower could dust it and force the leader to abort an otherwise healthy swap
+        (griefing, not theft -- both sides still recover). `pending` records "a
+        candidate exists that is merely NOT READY YET", and while it is set the answer
+        must be None: "not ready" outranks any other transaction's -1, because -1 is an
+        immediate-abort signal and None just keeps polling (and times out into the same
+        refund anyway).
+        """
+        rv = None
+        pending: bool = False
+        for txid, e in self._groupOutputsByTx(outputs).items():
+            if e["amount"] == cb_swap_value or check_amount is False:
+                if e["height"] == 0:
+                    # Still unconfirmed. [REU26 RUNG 6 REVIEW FIX] This used to set
+                    # rv = -1, conflating "in the mempool" with "protocol-invalid" -- on
+                    # an EVM/contract-chain leader that single bid event is enough to
+                    # trigger a chain-A refund of an otherwise healthy swap. Report "not
+                    # seen yet" instead and let the poll continue.
+                    self._log.debug(
+                        "Coin b lock txn {} not confirmed yet, waiting.".format(txid)
+                    )
+                    pending = True
+                    continue
+                unlock_time = None if unlock_times is None else unlock_times.get(txid)
+                if unlock_time is None:
+                    # The wallet-side history could not answer (rpc error, truncated
+                    # window, or the tx is not in it). Ask the daemon directly before
+                    # giving up.
+                    unlock_time = self._daemonTxUnlockTime(txid)
+                if unlock_time is None:
+                    # Still UNKNOWN. Fail closed in the safe direction: report "not seen
+                    # yet" (None, NOT -1) so the leader keeps chain A locked instead of
+                    # releasing it against a lock it has not verified it can sweep.
+                    # Timing out here refunds.
+                    self._log.warning(
+                        "Coin b lock txn {} found but its unlock time could not be "
+                        "verified; not accepting it yet.".format(txid)
+                    )
+                    pending = True
+                    continue
+                if unlock_time != 0:
+                    # Same defence as xmr.py's own unlock-time check: a
+                    # counterparty-chosen spend-time lock makes the ZANO leg unspendable
+                    # by us while chain A would already be released.
+                    self._log.warning(
+                        "Coin b lock txn is locked: {}, unlock_time {}".format(
+                            txid, unlock_time
+                        )
+                    )
+                    rv = -1
+                    continue
+                if not e["spendable"]:
+                    # Wallet-local BLOCKED/reserved flag -- informational only (it is
+                    # transient and not consensus), but no longer silently discarded.
+                    self._log.warning(
+                        "Coin b lock txn {} has outputs flagged not-spendable by the "
+                        "wallet.".format(txid)
+                    )
+                return {"txid": txid, "amount": e["amount"], "height": e["height"]}
+            if e["amount"] > 0:
+                self._log.warning(
+                    "Incorrect amount detected for coin b lock txn: {} "
+                    "({} outputs summing to {}, expected {})".format(
+                        txid, e["n"], e["amount"], cb_swap_value
+                    )
+                )
+                rv = -1
+        if pending:
+            # A real candidate is in flight but not verifiable yet. Never let another
+            # transaction's -1 abort the swap on its behalf -- see the docstring.
+            return None
+        return rv
+
+    def _findExistingSpend(self, rpc, count: int = 1000):
+        """Return the hex txid of an OUTGOING tx already made from this wallet, else None.
+
+        The Zano analogue of XMRInterface's `get_transfers {"out": True}` probe. Zano's
+        history entries do not have XMR's in/out tag lists; an outgoing tx is identified
+        by either wallet_transfer_info.employed_entries.spent being non-empty (the
+        wallet spent inputs of that tx) or a subtransfer with is_income == false. Both
+        are checked. The joint wallet is single-purpose, so any outgoing tx from it is
+        our own redeem/refund sweep.
+        """
+        try:
+            rv = rpc(
+                "get_recent_txs_and_info3",
+                {
+                    "offset": 0,
+                    "count": count,
+                    "update_provision_info": False,
+                    "exclude_mining_txs": False,
+                    "exclude_unconfirmed": False,
+                    "order": "FROM_END_TO_BEGIN",
+                },
+            )
+        except Exception as e:
+            self._log.warning(
+                "ZANO could not check the joint wallet for a spend: {}".format(e)
+            )
+            return None
+        for tx in rv.get("transfers", []):
+            tx_hash = tx.get("tx_hash")
+            if not tx_hash:
+                continue
+            employed = tx.get("employed_entries") or {}
+            is_out: bool = len(employed.get("spent") or []) > 0
+            if not is_out:
+                for by_pid in tx.get("subtransfers_by_pid") or []:
+                    for sub in by_pid.get("subtransfers") or []:
+                        if sub.get("is_income", True) is False:
+                            is_out = True
+                            break
+                    if is_out:
+                        break
+            if is_out:
+                return tx_hash
+        return None
+
+    def findTxnByHash(self, txid: str):
+        with self._mx_wallet:
+            try:
+                current_height: int = self.getChainHeight()
+            except Exception as e:
+                self._log.info("rpc failed %s", str(e))
+                current_height = None
+
+            outs = self.rpc_wallet("get_outputs", {"output_type": "all"})
+            # Same digit-denomination decomposition as findTxB (see _groupOutputsByTx):
+            # report the SUM of the transaction's outputs, not whichever single output
+            # was seen first.
+            e = self._groupOutputsByTx(outs.get("outputs", [])).get(txid)
+            if e is None or e["height"] == 0:
+                return None
+            if (
+                current_height is None
+                or current_height - e["height"] > self.blocks_confirmed
+            ):
+                return {"txid": txid, "amount": e["amount"], "height": e["height"]}
+            return None
+
+    def spendBLockTx(
+        self,
+        chain_b_lock_txid: bytes,
+        address_to: str,
+        kbv: bytes,
+        kbs: bytes,
+        cb_swap_value: int,
+        b_fee_rate: int,
+        restore_height: int,
+        spend_actual_balance: bool = False,
+        lock_tx_vout=None,
+    ) -> bytes:
+        with self._mx_wallet:
+            Kbv = self.getPubkey(kbv)
+            Kbs = self.getPubkey(kbs)
+            address_b58 = xmr_util.encode_address(Kbv, Kbs, self._addr_prefix)
+
+            wallet_filename = address_b58 + "_spend"
+            params = {
+                "filename": wallet_filename,
+                "address": address_b58,
+                "viewkey": b2h(kbv[::-1]),
+                "spendkey": b2h(kbs[::-1]),
+                "restore_height": restore_height,
+            }
+            # This is the exact REU26 rung-2 mechanic: generate_from_keys with BOTH the
+            # view key and the summed spend key b = s_a + s_b installs a full-spend
+            # wallet on the joint address. Safe to re-run on retry ONLY because it
+            # targets the SCRATCH connection -- it wipes and re-scans that process's
+            # account every time (reset_history).
+            self.createWallet(params)
+            rescanned: bool = self._waitWalletRescanned(self.rpc_wallet_scratch)
+
+            balance = self.rpc_wallet_scratch("getbalance")
+            if balance.get("balance", 0) < cb_swap_value:
+                # [REU26 RUNG 6 REVIEW FIX] Mirror XMRInterface's already-spent recovery
+                # branch, which ZanoInterface had dropped. A low balance on the joint
+                # wallet has TWO very different causes:
+                #   a) the lock was never funded / has not been rescanned yet ->
+                #      transient
+                #   b) our own redeem or refund ALREADY landed on chain, but the txid was
+                #      never persisted (RPC response lost, or the process died between
+                #      the daemon accepting the tx and bid.xmr_b_lock_tx.spend_txid
+                #      being written).
+                # Without this branch (b) was retried until _max_transient_errors and
+                # the bid was marked BID_ERROR even though the coins had been correctly
+                # redeemed. It is more likely on Zano than on Monero because of quirk 3
+                # (post-spend stale reads). reset_history() in the rung-0 patch makes the
+                # reinstalled wallet's history trustworthy, which is what makes this
+                # probe possible at all.
+                spent_txid = self._findExistingSpend(self.rpc_wallet_scratch)
+                if spent_txid is not None:
+                    self._log.warning(
+                        "spendBLockTx detected an existing spend from the joint wallet: "
+                        "{}.".format(spent_txid)
+                    )
+                    return bytes.fromhex(spent_txid)
+
+                self._log.error(
+                    "wallet {} balance {}, expected {}".format(
+                        wallet_filename, balance.get("balance", 0), cb_swap_value
+                    )
+                )
+                if not spend_actual_balance:
+                    raise TemporaryError("Invalid balance")
+
+            spend_value = cb_swap_value
+            if spend_actual_balance and balance.get("balance", 0) != cb_swap_value:
+                if not rescanned:
+                    # [REU26 RUNG 9 REVIEW FIX] _waitWalletRescanned fails open, and on
+                    # THIS path that converted into a partial sweep recorded as THE
+                    # refund: spend_value would be taken from a half-rescanned wallet,
+                    # `spend_value - fee` easily clears 0 (Zano decomposes a lock into
+                    # many digit outputs -- quirk 6), the partial sweep is broadcast, and
+                    # basicswap.py persists its txid and marks the tx TX_REFUNDED. The
+                    # remainder is then never swept. Raise instead: the caller retries,
+                    # and the balance is only ever spent once it is verified.
+                    self._log.error(
+                        "wallet {} rescan unconfirmed; refusing to spend its unverified "
+                        "balance {} (expected {}).".format(
+                            wallet_filename, balance.get("balance", 0), cb_swap_value
+                        )
+                    )
+                    raise TemporaryError("Wallet rescan unconfirmed")
+                self._log.warning(
+                    "Spending actual balance {}, not swap value {}.".format(
+                        balance.get("balance", 0), cb_swap_value
+                    )
+                )
+                spend_value = balance.get("balance", 0)
+            if balance.get("unlocked_balance", 0) < spend_value:
+                self._log.error(
+                    "wallet {} unlocked_balance {}, expected {}".format(
+                        wallet_filename, balance.get("unlocked_balance", 0), spend_value
+                    )
+                )
+                raise TemporaryError("Invalid unlocked_balance")
+
+            fee = self.make_int(self.get_fee_rate()[0])
+            send_amount = spend_value - fee
+            if send_amount <= 0:
+                # [REU26 RUNG 6 REVIEW FIX] This used to be ensure(...) -> a bare
+                # ValueError, which the retry machinery treats as permanent. On the
+                # key-recovery path (protocols/xmr_swap_1.py always passes
+                # spend_actual_balance=True) a not-yet-rescanned wallet gives
+                # spend_value == 0 and lands here, so a transient condition was reported
+                # as a hard failure. Also note ZANO's chainparams min_amount is now
+                # pinned above TX_MINIMUM_FEE so a valid offer cannot create a lock that
+                # is unsweepable by construction (see chainparams.py's min_amount note).
+                self._log.error(
+                    "wallet {} spend value {} does not cover the {} fee.".format(
+                        wallet_filename, spend_value, fee
+                    )
+                )
+                raise TemporaryError("Balance too low to cover fee")
+
+            # Zano has no sweep_all-shaped "send everything minus fee" RPC
+            # (sweep_below/sweep_bare_outs are NOT that -- see the mapping table).
+            # transfer() for (balance - fee) is the real sweep mechanic proven live in
+            # REU26 rung 2 step 5.
+            params = {
+                "destinations": [{"amount": send_amount, "address": address_to}],
+                "fee": fee,
+                "mixin": 0,
+                "payment_id": "",
+                "comment": "",
+            }
+            # SCRATCH connection: this sweep spends the JOINT wallet installed above,
+            # not the node's own funds. Sending it to rpc_wallet would try to pay the
+            # swap out of the node's main wallet instead.
+            rv = self.rpc_wallet_scratch("transfer", params)
+            # Quirk 3: do NOT re-query this same wallet-rpc connection's
+            # getbalance/get_outputs to "confirm" the spend -- it can read stale
+            # post-spend on this exact connection. The tx_hash in the transfer response
+            # IS the daemon-side ground truth (the daemon only returns a hash for a
+            # transaction it accepted); trust that, as REU26 rung 2's independent
+            # daemon-side verification did.
+            return bytes.fromhex(rv["tx_hash"])
+
+    def withdrawCoin(
+        self, value, addr_to: str, sweepall: bool, estimate_fee: bool = False
+    ) -> str:
+        with self._mx_wallet:
+            fee = self.make_int(self.get_fee_rate()[0])
+
+            if sweepall:
+                balance = self.rpc_wallet("getbalance")
+                if balance.get("balance", 0) != balance.get("unlocked_balance", 0):
+                    raise ValueError(
+                        "Balance must be fully confirmed to use sweep all."
+                    )
+                send_amount = balance.get("balance", 0) - fee
+                ensure(send_amount > 0, "Balance too low to cover fee")
+                params = {
+                    "destinations": [{"amount": send_amount, "address": addr_to}],
+                    "fee": fee,
+                    "mixin": 0,
+                    "payment_id": "",
+                    "comment": "",
+                }
+                if estimate_fee:
+                    return {
+                        "num_txns": 1,
+                        "sum_amount": send_amount,
+                        "sum_fee": fee,
+                        "sum_weight": 0,
+                    }
+                rv = self.rpc_wallet("transfer", params)
+                return rv["tx_hash"]
+
+            value_sats: int = self.make_int(value)
+            params = {
+                "destinations": [{"amount": value_sats, "address": addr_to}],
+                "fee": fee,
+                "mixin": 0,
+                "payment_id": "",
+                "comment": "",
+            }
+            if estimate_fee:
+                return {
+                    "num_txns": 1,
+                    "sum_amount": value_sats,
+                    "sum_fee": fee,
+                    "sum_weight": 0,
+                }
+            rv = self.rpc_wallet("transfer", params)
+            return rv["tx_hash"]
+
+    def estimateFee(self, value: int, addr_to: str, sweepall: bool) -> str:
+        return self.withdrawCoin(value, addr_to, sweepall, estimate_fee=True)
+
+    def showLockTransfers(self, kbv, Kbs, restore_height):
+        with self._mx_wallet:
+            try:
+                Kbv = self.getPubkey(kbv)
+                address_b58 = xmr_util.encode_address(Kbv, Kbs, self._addr_prefix)
+                wallet_file = address_b58 + "_spend"
+                kbv_le = kbv[::-1]
+                params = {
+                    "filename": wallet_file,
+                    "address": address_b58,
+                    "viewkey": b2h(kbv_le),
+                    "restore_height": restore_height,
+                }
+                self.createWallet(params)
+
+                # get_recent_txs_and_info3 is the reshaped equivalent of XMR's
+                # get_transfers (per the mapping table): {pi, transfers: [...],
+                # total_transfers, ...} rather than XMR's {in, out, pending, failed}
+                # tag-separated lists.
+                #
+                # [REU26 RUNG 6 REVIEW FIX] The params dict must NOT be empty. epee
+                # value-initializes the request struct, so an omitted `count` arrives as
+                # 0, and wallet2::get_recent_transfers_history opens with
+                #     if (!count || offset >= m_transfer_history.size()) return;
+                # -- it returned immediately and this view could never show a single
+                # CONFIRMED transfer.
+                rv = self.rpc_wallet_scratch(
+                    "get_recent_txs_and_info3",
+                    {
+                        "offset": 0,
+                        "count": 100,
+                        "update_provision_info": True,
+                        "exclude_mining_txs": False,
+                        "exclude_unconfirmed": False,
+                        "order": "FROM_END_TO_BEGIN",
+                    },
+                )
+                rv["filename"] = wallet_file
+                return rv
+            except Exception as e:
+                return {"error": str(e)}
+
+    def getSpendableBalance(self) -> int:
+        with self._mx_wallet:
+            balance_info = self.rpc_wallet("getbalance")
+            return balance_info.get("unlocked_balance", 0)
+
+    def changeWalletPassword(
+        self, old_password, new_password, check_seed_if_encrypt: bool = True
