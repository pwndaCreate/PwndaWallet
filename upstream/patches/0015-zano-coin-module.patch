+
+    def getDaemonVersion(self):
+        # [REU26 RUNG 6 REVIEW FIX -- the previous comment here was factually wrong.]
+        # Zano exposes NO version string on either RPC surface: the wallet-rpc has no
+        # get_version method, and COMMAND_RPC_GET_INFO (rpc/core_rpc_server_commands_defs.h)
+        # has no version field either -- it carries height/difficulty/fee/hardfork data
+        # only. The closest thing is getinfo's `is_hardfok_active` list (sic -- Zano's
+        # own spelling), which is filled unconditionally at
+        # rpc/core_rpc_server.cpp:177-181, so report the highest active hardfork as the
+        # build identifier instead of pretending to read a version field that does not
+        # exist. Callers only log/display this value; nothing on the swap path parses it.
+        if self._core_version is None:
+            self._core_version = "unknown"
+            try:
+                info = self.rpc2("getinfo", timeout=self._rpctimeout)
+                hf_active = info.get("is_hardfok_active") or []
+                active = [i for i, v in enumerate(hf_active) if v]
+                if active:
+                    self._core_version = "zano (hf {})".format(max(active))
+            except Exception:
+                pass
+        return self._core_version
+
+    def getBlockchainInfo(self):
+        """[REU26 RUNG 8 FIX] verificationprogress used to be hardcoded to 1.0.
+
+        On a private, isolated chain a node is at the tip by construction, so "1.0" was
+        tautologically true and the bug was invisible. Against the PUBLIC Zano testnet
+        it is simply false: a freshly started node reported
+        `{"blocks": 69550, "verificationprogress": 1.0}` while the network was at
+        161,670 -- i.e. it claimed to be fully synced at 43%. Two real consequences,
+        neither reachable on a private chain:
+          - basicswap.py's checkAndNotifyBalanceChange skips the notification only when
+            progress < 0.99, so ZANO balance-change events fired off a partially-synced
+            chain.
+          - basicswap.py's UI renders 100 * verificationprogress, so the UI showed
+            "100.00%" for a 43%-synced node.
+
+        The fix mirrors XMRInterface.getBlockchainInfo, which divides the local height
+        by the best height the network has advertised. Zano's getinfo exposes exactly
+        that as `max_net_seen_height`.
+
+        Offline/private chains are unaffected BY CONSTRUCTION: with no peers
+        `max_net_seen_height` cannot exceed our own height, and the max() below then
+        makes known_block_count == blocks and progress == 1.0, which is the old
+        behaviour and is correct there.
+        """
+        get_height = self.getChainHeight(full_output=True)
+        rv = {
+            "blocks": get_height.get("height", 0),
+            "verificationprogress": 0.0,
+        }
+        try:
+            info = self.rpc2("getinfo", timeout=self._rpctimeout)
+            # max_net_seen_height: the highest block height any connected peer has
+            # advertised.
+            known = int(info.get("max_net_seen_height", 0) or 0)
+            rv["known_block_count"] = max(known, rv["blocks"])
+            if rv["known_block_count"] > 0:
+                rv["verificationprogress"] = min(
+                    1.0, rv["blocks"] / rv["known_block_count"]
+                )
+        except Exception as e:
+            # Fail CLOSED: an unknown sync state must not read as "fully synced", or the
+            # balance-notification gate above is bypassed. This is what xmr.py does too.
+            self._log.warning(
+                "{} getinfo failed while computing sync progress: {}".format(
+                    self.ticker_str(), e
+                )
+            )
+            rv["verificationprogress"] = 0.0
+        return rv
+
+    def getChainHeight(self, full_output: bool = False):
+        # Zano daemon: GET-able flat endpoint /getheight (COMMAND_RPC_GET_HEIGHT ->
+        # {height, status}), reached the same way XMR's rpc2('get_height') is
+        # (make_xmr_rpc2_func posts method-as-path). Confirmed live in REU26 rung1.
+        for i in range(self._num_chaininfo_retries):
+            try:
+                get_height = self.rpc2("getheight", timeout=self._rpctimeout)
+                return get_height if full_output else get_height["height"]
+            except Exception as e:
+                if i < self._num_chaininfo_retries - 1 and self.is_transient_error(e):
+                    import time
+
+                    time.sleep(self._chaininfo_retry_delay)
+                    continue
+                raise
+
+    def getWalletInfo(self):
+        with self._mx_wallet:
+            rv = {}
+            try:
+                balance_info = self.rpc_wallet("getbalance")
+            except Exception as e:
+                if "no connection" in str(e).lower() or "connection" in str(e).lower():
+                    return {
+                        "encrypted": False,
+                        "locked": False,
+                        "balance": 0,
+                        "unconfirmed_balance": 0,
+                    }
+                raise
+
+            wi = self.rpc_wallet("get_wallet_info")
+            # [REU26 RUNG 6 REVIEW FIX] get_wallet_info's current_height is the TOP
+            # BLOCK HEIGHT (m_local_bc_size - 1) while the UI compares this against
+            # known_block_count, which comes from the daemon's blockchain SIZE -- so
+            # reporting it raw rendered a permanently "one behind" N-1 / N wallet page.
+            # Convert to the same units. See _waitWalletRescanned for the full source
+            # citation.
+            wallet_top = wi.get("current_height")
+            rv["wallet_blocks"] = 0 if wallet_top is None else wallet_top + 1
+            # COMMAND_RPC_GET_BALANCE: balance = total (locked+unlocked),
+            # unlocked_balance = spendable now. Same two-field shape XMRInterface
+            # expects, just via 'getbalance' instead of 'get_balance' -- a straight
+            # rename (see the mapping table in ResearchWiki).
+            rv["balance"] = self.format_amount(balance_info.get("unlocked_balance", 0))
+            rv["unconfirmed_balance"] = self.format_amount(
+                max(0, balance_info.get("balance", 0) - balance_info.get("unlocked_balance", 0))
+            )
+            rv["encrypted"] = False if self._wallet_password is None else True
+            rv["locked"] = False
+            return rv
+
+    def getMainWalletAddress(self) -> str:
+        with self._mx_wallet:
+            return self.rpc_wallet("getaddress")["address"]
+
+    def getNewAddress(self, placeholder) -> str:
+        # STUB: no subaddress-style "new receive address" primitive on this RPC surface
+        # (see header note). Never called on the swap path itself (only the wallet UI's
+        # receive tab) -- returning the wallet's one address is a safe, documented
+        # approximation.
+        with self._mx_wallet:
+            return self.rpc_wallet("getaddress")["address"]
+
+    def get_fee_rate(self, conf_target: int = 2):
+        # Zano's transfer/sweep RPCs take an explicit numeric 'fee' (see
+        # COMMAND_RPC_TRANSFER) with no fee-estimate RPC of the XMR get_fee_estimate
+        # shape. DEFAULT_FEE from Zano's own currency_config.h (0.01 ZANO = 1e10 atomic
+        # units) is used as a flat estimate; not a dynamic mempool-based estimate, but
+        # the swap path only needs a defensible planning number.
+        DEFAULT_ZANO_FEE_ATOMIC = 10000000000  # 0.01 ZANO, matches REU26 rung1/2's observed fee
+        return float(self.format_amount(DEFAULT_ZANO_FEE_ATOMIC)), "zano_default_fee"
