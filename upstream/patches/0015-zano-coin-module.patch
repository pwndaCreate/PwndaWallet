+    def isValidAddress(self, address: str) -> bool:
+        # No decode_address helper in util_xmr.py, so this decodes the base58 blob
+        # directly: it is exactly encode_address's own layout inverted --
+        # prefix_varint + spend(32) + view(32) + checksum(4), tag 0xc5 for a plain Zano
+        # address (confirmed against a real mainnet address in REU26's offline VERIFY
+        # work -- see zano-xmr-swap-feasibility.md, "The address needs no code change").
+        try:
+            raw = bytes.fromhex(xmr_b58decode(address))
+            prefix_bytes = encode_varint(self._addr_prefix)
+            plen = len(prefix_bytes)
+            ensure(raw[:plen] == prefix_bytes, "Bad address prefix")
+            ensure(len(raw) == plen + 32 + 32 + 4, "Bad address length")
+            spend_point = raw[plen : plen + 32]
+            view_point = raw[plen + 32 : plen + 64]
+            checksum = raw[plen + 64 :]
+            expect = bytes.fromhex(xmr_util.cn_fast_hash(raw[: plen + 64])[0:8])
+            ensure(checksum == expect, "Bad address checksum")
+            return self.verifyPubkey(spend_point) and self.verifyPubkey(view_point)
+        except Exception as e:
+            self._log.warning(f"Invalid {self.ticker()} address: {e}")
+            return False
