+                        "count": fetch_count,
+                        "update_provision_info": False,
+                        "exclude_mining_txs": False,
+                        "exclude_unconfirmed": False,
+                        "order": "FROM_END_TO_BEGIN",
+                    },
+                )
+                transactions = rv.get("transfers", [])
+                transactions.sort(key=lambda x: x.get("timestamp", 0), reverse=True)
+                return (
