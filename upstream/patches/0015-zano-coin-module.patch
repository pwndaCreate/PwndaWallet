+    def getTransaction(self, txid: bytes):
+        # Daemon-side lookup (COMMAND_RPC_GET_TRANSACTIONS via the flat
+        # /gettransactions endpoint -- same shape as XMR's
+        # rpc2('get_transactions', ...)).
