diff --git a/basicswap/interface/zano/rpc.py b/basicswap/interface/zano/rpc.py
new file mode 100644
index 0000000..dc08bde
--- /dev/null
+++ b/basicswap/interface/zano/rpc.py
@@ -0,0 +1,189 @@
+# -*- coding: utf-8 -*-
+
+# Copyright (c) 2026 PwndaWallet swap sidecar (this module: PWNDA-PATCH-15).
+# Distributed under the MIT software license, see the accompanying
+# file LICENSE or http://www.opensource.org/licenses/mit-license.php.
+
+# PWNDA-PATCH-15: Zano wallet-rpc JSON-RPC client, JWT (HS256) authenticated.
+#
+# Zano's wallet_rpc_server (unlike Monero's, which rpc_xmr.py's JsonrpcDigest speaks
+# HTTP Digest to) requires an HS256-signed `Zano-Access-Token` header on every request
+# (wallet_rpc_server.cpp::auth_http_request) -- there is no 401-challenge round trip the
+# way Digest has, so a fresh token is minted and sent with the FIRST request every time,
+# not negotiated after a rejection.
+#
+# The algorithm here is a faithful, line-for-line port of pwnda's own
+# src-tauri/src/zano_rpc.rs::build_jwt (this repo) -- the ONLY reference used, per Grove
+# expansion master plan unit B-X1's instructions ("do not invent a different scheme").
+# That Rust implementation is Phase-0 LIVE-VERIFIED against the real
+# `simplewallet v2.2.1.506[b76fa18]` binary (see zano_rpc.rs's own header and its
+# `body_hash_is_sha256_not_keccak` test) and carries one hard-won correction worth
+# repeating here: the base64 alphabet is STANDARD (`+`/`/`), NOT base64url, because
+# upstream's decode is `jwt::base::decode<jwt::alphabet::base64>(jwt::base::pad<...>(str))`
+# -- a first pass that used base64url passed on payloads whose encoding happened not to
+# contain `+`/`/` and failed (coin-flip flakiness) on the rest.
+#
+# NOT rpc_xmr.py's JsonrpcDigest/Transport machinery: that stack exists specifically for
+# Digest's server-issued-nonce challenge, which JWT has no equivalent of. http.client is
+# used directly (stdlib only, matching the ~50-line budget in
+# grove-zeph-zano-integration-plan.md 2.3) rather than pulling in a new HTTP dependency.
+
+import base64
+import hashlib
+import hmac
+import http.client
+import json
+import secrets
+import time
+
+# Header name upstream looks for (wallet_rpc_server.h) -- must match
+# src-tauri/src/zano_rpc.rs::ZANO_ACCESS_TOKEN_HEADER exactly.
+ZANO_ACCESS_TOKEN_HEADER = "Zano-Access-Token"
+
+# Token lifetime. Short-lived per upstream's own guidance; upstream additionally tracks
+# salts for an hour, so replay is blocked even inside this window (see build_jwt below).
+_JWT_TTL_SECONDS = 60
+
+
+def _b64std_nopad(data: bytes) -> str:
+    """STANDARD base64 alphabet (+/), padding stripped -- NOT base64url.
+
+    Ported from zano_rpc.rs::b64std_nopad. Python's base64.b64encode already uses the
+    STANDARD alphabet by default (unlike urlsafe_b64encode), so this is just padding
+    removal -- but the choice is load-bearing, not incidental, per the module docstring.
+    """
+    return base64.b64encode(data).decode("ascii").rstrip("=")
+
+
+def build_jwt(secret: str, body: str) -> str:
+    """Build one Zano-Access-Token value for a single request body (HS256).
+
+    Ported from zano_rpc.rs::build_jwt. Upstream verifies: an HS256 signature over the
+    shared secret, body_hash == hex(sha256(request body)) (SHA-256, NOT keccak -- Zano is
+    not an EVM chain), and that salt has not been seen before. The salt is what makes a
+    token single-use, so it MUST be freshly random per call -- reusing one is an auth
+    failure at the server, not a client-side cache hit. exp is a hard expiry the server
+    enforces, not just documentation: a token built with a stale exp is rejected.
+    """
+    body_hash = hashlib.sha256(body.encode("utf-8")).hexdigest()
+    # 16 random bytes -> 32 hex chars, matching zano_rpc.rs::random_hex(16) (one hex byte
+    # pair per random byte -- secrets.token_hex(16) is the exact Python equivalent).
+    salt = secrets.token_hex(16)
+
+    header = {"alg": "HS256", "typ": "JWT"}
+    exp = int(time.time()) + _JWT_TTL_SECONDS
+    payload = {"body_hash": body_hash, "salt": salt, "exp": exp}
+
+    # Compact JSON (no inserted whitespace), matching serde_json::to_string's output
+    # shape. Key ORDER inside the JSON object is not load-bearing for verification --
+    # the server does not re-derive this string from the decoded values, it HMACs the
+    # raw base64 segments it actually received -- but compactness (no stray spaces) is,
+    # since the signing input is these exact bytes.
+    header_b64 = _b64std_nopad(
+        json.dumps(header, separators=(",", ":")).encode("utf-8")
+    )
+    payload_b64 = _b64std_nopad(
+        json.dumps(payload, separators=(",", ":")).encode("utf-8")
+    )
+    signing_input = "{}.{}".format(header_b64, payload_b64)
+
+    sig = hmac.new(
+        secret.encode("utf-8"), signing_input.encode("utf-8"), hashlib.sha256
+    ).digest()
+    return "{}.{}".format(signing_input, _b64std_nopad(sig))
+
+
+def callrpc_zano(
+    rpc_port: int,
+    jwt_secret: str,
+    method: str,
+    params=None,
+    rpc_host: str = "127.0.0.1",
+    timeout: int = 120,
+    tag: str = "",
+):
+    """One JSON-RPC call against a Zano wallet-rpc, JWT-authenticated.
+
+    Call/return shape mirrors rpc_xmr.py's callrpc_xmr: raises ValueError (never a bare
+    exception) tagged with `tag`, returns r["result"] on success -- so callers written
+    against make_xmr_rpc_func's contract need no special-casing for the JWT transport.
+    """
+    request_body = {
+        "jsonrpc": "2.0",
+        "id": "0",
+        "method": method,
+        "params": params if params is not None else {},
+    }
+    body_str = json.dumps(request_body)
+    token = build_jwt(jwt_secret, body_str)
+
+    conn = http.client.HTTPConnection(rpc_host, rpc_port, timeout=timeout)
+    try:
+        try:
+            conn.request(
+                "POST",
+                "/json_rpc",
+                body=body_str.encode("utf-8"),
+                headers={
+                    "Content-Type": "application/json",
+                    ZANO_ACCESS_TOKEN_HEADER: token,
+                },
+            )
+            resp = conn.getresponse()
+            raw = resp.read()
+            status = resp.status
+        except Exception as ex:
+            raise ValueError(f"{tag}RPC Server Error: {ex}")
+    finally:
+        conn.close()
+
+    if status == 401:
+        # Distinct from a transport error: the token was REJECTED (bad secret, reused
+        # salt, or a body-hash mismatch) -- a bug in this client/config, not a
+        # user-facing condition. Mirrors zano_rpc.rs::do_rpc_call_jwt's explicit branch.
+        raise ValueError(
+            f"{tag}Zano RPC rejected the JWT (401) -- secret/salt/body-hash mismatch"
+        )
+    if status != 200:
+        raise ValueError(f"{tag}RPC Server Error: HTTP {status}: {raw!r}")
+
+    try:
+        r = json.loads(raw.decode("utf-8"))
+    except Exception as ex:
+        raise ValueError(f"{tag}RPC Server Error: bad JSON response: {ex}")
+
+    if "error" in r and r["error"] is not None:
+        raise ValueError(f"{tag}RPC error: {r['error']}")
+
+    return r["result"]
+
+
+def make_zano_rpc_func(
+    port: int,
+    jwt_secret: str,
+    host: str = "127.0.0.1",
+    default_timeout: int = 120,
+    tag: str = "",
+):
+    """Factory matching rpc_xmr.py's make_xmr_rpc_func call shape.
+
+    Returned closure: rpc_func(method, params=None, timeout=default_timeout) -> result.
+    Used for BOTH the main and scratch wallet-rpc connections in zano.py -- each gets its
+    OWN jwt_secret (Grove mints one per session per connection), which is fine even
+    though pwnda's own Rust side may hold an independent client against the same main
+    wallet at the same time: salts are per-request random, never coordinated between
+    clients, by design (see grove-zeph-zano-integration-plan.md 2.3).
+    """
+
+    def rpc_func(method, params=None, timeout=default_timeout):
+        return callrpc_zano(
+            port,
+            jwt_secret,
+            method,
+            params=params,
+            rpc_host=host,
+            timeout=timeout,
+            tag=tag,
+        )
+
+    return rpc_func
\ No newline at end of file
