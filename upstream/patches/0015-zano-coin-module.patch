+    def listWalletTransactions(self, count=100, skip=0, include_watchonly=True):
+        try:
+            with self._mx_wallet:
+                # [REU26 RUNG 6 REVIEW FIX] `{}` made this return zero confirmed
+                # transfers, always -- epee value-initializes `count` to 0 and
+                # wallet2::get_recent_transfers_history bails out on !count. See
+                # showLockTransfers for the full note. Fetch skip+count from the end so
+                # the local slice below still works.
+                fetch_count: int = (skip + count) if count else 1000
+                rv = self.rpc_wallet(
