+    def testDaemonRPC(self, with_wallet=True) -> None:
+        # XMRInterface calls rpc_wallet('get_languages'), which Zano does not have.
+        # getaddress is the cheapest real call that proves the wallet-rpc connection is
+        # alive and responding (and, since PWNDA-PATCH-15 (b), that its JWT secret is
