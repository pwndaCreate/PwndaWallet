+ZANO_RPC_PORT = int(os.getenv("ZANO_RPC_PORT", 22212))  # unused: no local daemon in Grove
+ZANO_WALLET_RPC_HOST = os.getenv("ZANO_WALLET_RPC_HOST", "127.0.0.1")
+ZANO_WALLET_RPC_PORT = int(os.getenv("ZANO_WALLET_RPC_PORT", 18084))  # main, host-managed
+ZANO_SCRATCH_WALLET_RPC_PORT = int(
+    os.getenv("ZANO_SCRATCH_WALLET_RPC_PORT", 18086)
+)  # scratch, pwnda-spawned per swap
