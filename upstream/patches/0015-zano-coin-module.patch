+        #
+        # [REU26 RUNG 6 REVIEW FIX] Hard gate, not a warning. If no scratch connection
+        # was configured there is NO safe connection to run generate_from_keys on, so
+        # refuse rather than silently destroying the node's live account (quirk 4 --
+        # irreversible for the life of the simplewallet process, and it would also
+        # poison main_wallet_addr_zano).
+        if not self._has_scratch_wallet or self.rpc_wallet_scratch is None:
+            raise ValueError(
+                "ZANO: refusing to run generate_from_keys - no 'scratchwalletrpcport' is "
+                "configured, and running it on the main wallet-rpc would irreversibly "
+                "destroy this node's main swap wallet. Configure a second simplewallet "
+                "process."
+            )
+        if self._wallet_password is not None:
+            params.setdefault("password", self._wallet_password)
+        else:
+            params.setdefault("password", "")
+        rv = self.rpc_wallet_scratch("generate_from_keys", params)
+        if "address" in rv:
+            new_address: str = rv["address"]
+            is_watch_only: bool = "spendkey" not in params or params.get("spendkey", "") == ""
+            self._log.info(
+                "Generated{} {} wallet: {}".format(
+                    " watch-only" if is_watch_only else "",
+                    self.coin_name(),
+                    self._log.addr(new_address) if hasattr(self._log, "addr") else new_address,
+                )
+            )
+            return rv
+        else:
+            self._log.debug("generate_from_keys %s", dumpj(rv))
+            raise ValueError("generate_from_keys failed")
