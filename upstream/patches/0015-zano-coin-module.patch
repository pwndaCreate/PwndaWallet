+    def _waitWalletRescanned(self, rpc, timeout: int = 180) -> bool:
+        """Block until the scratch wallet has rescanned up to the daemon's tip.
+
+        Returns True only if the rescan was OBSERVED to reach the tip. False means
+        "could not confirm" (timed out, or the daemon height could not be read), and
+        callers that are about to trust this wallet's `getbalance` as an amount must
+        treat that as fatal-for-now.
+        [REU26 RUNG 9 REVIEW FIX] It used to return the last height seen and every
+        caller ignored it, i.e. it failed OPEN -- see spendBLockTx's
+        spend_actual_balance branch for why that mattered.
+
+        [REU26 RUNG 5-6] generate_from_keys now calls wallet2::reset_history() (the C++
+        half of the stale-cache fix -- see the patch), so a freshly-installed account
+        starts from a CLEARED transfer container and rescans from restore_height. That
+        is what makes its getbalance/get_outputs trustworthy, but it also means those
+        calls return an empty wallet until the rescan catches up. Reading too early is
+        not dangerous (findTxB just reports "not found yet" and BasicSwap retries) but
+        it wastes whole poll cycles, so wait for the wallet's own current_height to
+        reach the daemon tip first.
+
+        [REU26 RUNG 6 REVIEW FIX - OFF BY ONE] The two heights being compared are NOT
+        the same quantity and must be reconciled before comparing:
+          - daemon /getheight  -> core.get_current_blockchain_size() (rpc/core_rpc_server.cpp:130),
+            i.e. the blockchain SIZE = top block height + 1. Zano's own getinfo doc
+            string for the same value says "equal to the height of the top block plus
+            one".
+          - wallet get_wallet_info["current_height"] -> wallet2::get_top_block_height()
+            (wallet/wallet_rpc_server.cpp:427) = block_chain_shortener::get_top_block_height()
+            = m_local_bc_size - 1 (currency_core/block_chain_shortener.cpp:35-38), i.e.
+            the TOP BLOCK HEIGHT.
+        So a fully synced wallet always reports exactly (daemon size - 1). Comparing
+        them directly could only ever succeed after a NEW block was mined, which made
+        every joint-wallet operation burn a full block interval -- and the whole 180s
+        timeout whenever block production paused. Convert the daemon size to a top-block
+        height and compare like with like.
+        """
+        try:
+            target_top: int = max(0, self.getChainHeight() - 1)
+        except Exception as e:
+            self._log.warning(
+                "ZANO wallet rescan wait could not read the daemon height: {}".format(
+                    str(e)
+                )
+            )
+            return False
+        import time as _time
+
+        deadline = _time.time() + timeout
+        last: int = 0
+        while _time.time() < deadline:
+            try:
+                last = rpc("get_wallet_info").get("current_height", 0)
+            except Exception:
+                last = 0
+            if last >= target_top:
+                return True
+            _time.sleep(2)
+        self._log.warning(
+            "ZANO wallet rescan did not reach daemon top block height {} within {}s "
+            "(at {}).".format(target_top, timeout, last)
+        )
+        return False
