+    # PWNDA-PATCH-37: a host wallet's identity is pinned across restarts
+    # while swaps on its coin are in progress.
+    #
+    # XMR/ZEPH (PATCH-5/8) and ZANO (PATCH-17/35) confirm the host wallet's
+    # address once per session and refuse spends from any other. That
+    # confirmation trusted whatever wallet was open, so a node restarted
+    # with a different wallet open in the app confirmed THAT one, and a
+    # swap started with the first wallet funded from, or redeemed into,
+    # the second.
+    #
+    # All DB access is here, never inside an interface's _mx_wallet: the
+    # bid loop holds the DB lock while it calls into interfaces, so taking
+    # the DB lock under _mx_wallet could deadlock against it. Interfaces
+    # only compare against _pwnda_expected_main_wallet, which this sets.
+    def pwndaHostWalletPinKey(self, ci) -> str:
+        return "pwnda_host_wallet_pin_" + ci.coin_name().lower()
+
+    def pwndaCoinHasActiveBids(self, coin_type) -> bool:
+        cursor = self.openDB()
+        try:
+            query = (
+                "SELECT COUNT(*) FROM bids INNER JOIN offers "
+                "ON bids.offer_id = offers.offer_id "
+                "WHERE (offers.coin_from = :coin OR offers.coin_to = :coin) AND"
+                + self.activeBidsQueryStr()
+            )
+            row = cursor.execute(
+                query, {"coin": int(coin_type), "now": self.getTime()}
+            ).fetchone()
+            return row is not None and row[0] > 0
+        finally:
+            self.closeDB(cursor, commit=False)
+
+    def pwndaSyncHostWalletPins(self) -> None:
+        for c in self.activeCoins():
+            try:
+                ci = self.ci(c)
+            except Exception:
+                continue
+            if not getattr(ci, "_external_main_wallet", False):
+                continue
+            if not hasattr(ci, "_pwnda_expected_main_wallet"):
+                continue
+            key = self.pwndaHostWalletPinKey(ci)
+            try:
+                pinned = self.getStringKV(key)
+                confirmed = ci._cached_main_wallet_address
+                if confirmed is not None:
+                    # This session's identity. PATCH-8/17 refuse drift from
+                    # it, so it is the wallet any bid started this session
+                    # uses.
+                    if confirmed != pinned:
+                        self.setStringKV(key, confirmed)
+                        if pinned is not None:
+                            self.log.info(
+                                f"PWNDA-PATCH-37: {ci.coin_name()} host wallet "
+                                f"pin moved to the wallet confirmed this session"
+                            )
+                    ci._pwnda_expected_main_wallet = None
+                    continue
+                busy = pinned is not None and self.pwndaCoinHasActiveBids(c)
+                ci._pwnda_expected_main_wallet = pinned if busy else None
+            except Exception as e:
+                # Keep the interface's expectation as it was: an unreadable
+                # pin must not be read as nothing to protect.
+                self.log.warning(
+                    f"PWNDA-PATCH-37: could not sync the {ci.coin_name()} "
+                    f"host wallet pin: {e}"
+                )
+
     def getCachedMainWalletAddress(self, ci, cursor=None):
         db_key = "main_wallet_addr_" + ci.coin_name().lower()
         cached_addr = self.getStringKV(db_key, cursor)
@@ -16036,6 +16114,11 @@ class BasicSwap(BaseApp, BSXNetwork, UIApp):
