# Copy this file to `.env.development.local` and fill in the values you
# want for your local dev workflow. `.env.development.local` is
# gitignored; this `.example` is the committed template.
#
# Each variable is dev-only — Vite only loads `.env.development*`
# files when `import.meta.env.DEV` is true. Production builds
# (`vite build`, `tauri build`) never see these values.

# Skip the vault unlock screen and mount the dashboard with a BIP39
# test wallet. As of 2026-05-16 this flag ALSO requires
# `VITE_DEV_INSTANCE=sandbox` to fire — setting it here on the main dev
# instance is intentionally a no-op (it used to render the public test
# wallet's $3k+ accumulated funds on top of the user's real wallet).
#
# To use the bypass for visual iteration, run `npm run dev:sandbox` /
# `npm run tauri:dev:sandbox` instead — those load `.env.sandbox.local`,
# which carries both flags. See CLAUDE.md § "Isolated Claude Iteration
# Sandbox".
VITE_SKIP_AUTH=
