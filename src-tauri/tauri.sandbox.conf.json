{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "PWNDA Wallet (Dev Sandbox)",
  "identifier": "com.pwnda.wallet.sandbox-dev",
  "build": {
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev:sandbox"
  },
  "app": {
    "windows": [
      {
        "title": "PWNDA Wallet — Dev Iteration Sandbox",
        "label": "claude",
        "additionalBrowserArgs": "--js-flags=--expose-gc --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-gpu-compositing"
      }
    ]
  }
}
