{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "PwndaWallet",
  "version": "0.6.0",
  "identifier": "com.pwnda.wallet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PwndaWallet",
        "width": 1280,
        "height": 720,
        "minWidth": 480,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "additionalBrowserArgs": "--js-flags=--expose-gc --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "binaries/*",
      "nsis/cleanup-uninstall.ps1"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Multi-chain crypto wallet with integrated mining",
    "longDescription": "PwndaWallet — desktop wallet for BTC, ETH/EVM, SOL, ADA, XMR, ZEPH, ERG, and more, with built-in CPU/GPU mining (XMRig, lolMiner, SRBMiner). Local-first; no telemetry; user controls every key.",
    "windows": {
      "wix": {
        "fragmentPaths": [
          "wix/defender-fragment.wxs"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "bzip2",
          "tar"
        ],
        "section": "utils"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "bzip2",
          "tar"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/pwndaCreate/PwndaWallet/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1QjI2QzYxQTZCOUVEMzYKUldRMjdibW1ZV3l5VlZIbVlkd2lSNTNXMXc1cTBzWTlHaHNpOWlQQUZueDcvSjBFNHdzM3FSbkkK"
    }
  }
}
