{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "PwndaLite",
  "version": "0.5.0",
  "identifier": "com.pwnda.lite",
  "build": {
    "frontendDist": "../dist-lite",
    "devUrl": "http://localhost:1420/index-lite.html",
    "beforeDevCommand": "npm run dev:lite",
    "beforeBuildCommand": "npm run build:lite"
  },
  "app": {
    "windows": [
      {
        "title": "PwndaLite",
        "width": 720,
        "height": 900,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "label": "lite",
        "additionalBrowserArgs": "--js-flags=--expose-gc --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Mining-only build of PwndaWallet",
    "longDescription": "PwndaLite — the mining subsystem of PwndaWallet packaged as a standalone product. No wallet, no vault, no swap; the user supplies a mining address in Settings.",
    "windows": {
      "wix": {
        "fragmentPaths": ["wix/defender-fragment.wxs"]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "utils"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libappindicator-gtk3"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/pwndaCreate/PwndaWalletDevelopment/releases/latest/download/latest-lite.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyQTk2M0Y3RjMxNDc2NTkKUldSWmRoVHo5Mk9wRXRMWkJXamwxajRtcUZtTTBoOERrQjVlQi9abUU3QmlEL0Q1NitwSTZNRjEK"
    }
  }
}
