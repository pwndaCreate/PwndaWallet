{
  "name": "tauri-eth-wallet",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "vite --port 1421 --strictPort --mode sandbox",
    "dev:lite": "node scripts/run-lite.mjs vite",
    "dev:web": "node scripts/run-with-env.mjs VITE_ENTRY=web vite",
    "dev:catalog": "node scripts/run-with-env.mjs VITE_ENTRY=catalog vite",
    "dev:catalog:lite": "node scripts/run-with-env.mjs VITE_ENTRY=catalog VITE_BUILD_VARIANT=lite vite",
    "prebuild": "node scripts/sync-feather-nodes.mjs && node scripts/check-pool-hosts.mjs && node scripts/check-boundaries.mjs && node scripts/check-dead-config.mjs && node scripts/check-fleet-pin.mjs && node scripts/generate-tokens-css.mjs --check",
    "prebuild:lite": "node scripts/check-pool-hosts.mjs && node scripts/check-boundaries.mjs && node scripts/check-fleet-pin.mjs && node scripts/generate-tokens-css.mjs --check",
    "build": "vite build",
    "build:lite": "npm run prebuild:lite && node scripts/run-lite.mjs vite build --outDir dist-lite",
    "build:catalog": "node scripts/run-with-env.mjs VITE_ENTRY=catalog vite build --outDir dist-catalog",
    "check-types": "tsc --noEmit",
    "check-boundaries": "node scripts/check-boundaries.mjs",
    "check-linux": "powershell -ExecutionPolicy Bypass -File scripts/check-linux-docker.ps1",
    "check-defects": "node scripts/swap/check-defect-register.mjs",
    "check-dead-config": "node scripts/check-dead-config.mjs",
    "check-pool-hosts": "node scripts/check-pool-hosts.mjs",
    "check-fleet-pin": "node scripts/check-fleet-pin.mjs",
    "check-tokens": "node scripts/generate-tokens-css.mjs --check",
    "check-file-sizes": "node scripts/check-file-sizes.mjs",
    "check-rpc-endpoints": "node scripts/check-rpc-endpoints.mjs",
    "wiki-coverage": "node scripts/wiki-coverage.mjs",
    "gen-tokens": "node scripts/generate-tokens-css.mjs",
    "new-token": "node scripts/new-token.mjs",
    "new-primitive": "node scripts/new-primitive.mjs",
    "legacy-css-usage": "node scripts/legacy-css-usage.mjs",
    "snapshot:catalog": "node scripts/snapshot-catalog.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-nodes": "node scripts/sync-feather-nodes.mjs",
    "test:zph-nodes": "node scripts/zephyr-node-probe.mjs",
    "kill-sidecars": "node scripts/kill-orphan-sidecars.mjs",
    "tauri": "node scripts/swap/dev-sidecar-env.mjs node scripts/run-with-env.mjs tauri",
    "tauri:dev": "node scripts/swap/dev-sidecar-env.mjs node scripts/run-with-env.mjs tauri dev",
    "tauri:dev:sandbox": "node scripts/run-with-env.mjs CARGO_TARGET_DIR=target-sandbox tauri dev --config src-tauri/tauri.sandbox.conf.json",
    "tauri:dev:linux": "powershell -ExecutionPolicy Bypass -File scripts/dev-linux-wsl.ps1",
    "tauri:dev:linux:sandbox": "powershell -ExecutionPolicy Bypass -File scripts/dev-linux-wsl.ps1 -Sandbox",
    "tauri:dev:lite": "node scripts/run-with-env.mjs tauri dev --config src-tauri/tauri-lite.conf.json --features lite",
    "tauri:build": "npm run check-bundle:win && node scripts/run-with-env.mjs tauri build",
    "tauri:build:lite": "node scripts/run-with-env.mjs tauri build --config src-tauri/tauri-lite.conf.json --features lite",
    "fetch-miners": "node scripts/fetch-miners.mjs",
    "fetch-miners:win": "node scripts/fetch-miners.mjs win32",
    "fetch-miners:linux": "node scripts/fetch-miners.mjs linux",
    "fetch-sidecars": "node scripts/fetch-sidecars.mjs",
    "fetch-sidecars:win": "node scripts/fetch-sidecars.mjs win32",
    "fetch-sidecars:linux": "node scripts/fetch-sidecars.mjs linux",
    "build:linux": "node scripts/fetch-miners.mjs linux && node scripts/fetch-sidecars.mjs linux && npm run bundle:linux && npm run check-bundle:linux && tauri build --bundles deb,appimage,rpm",
    "build:linux:lite": "tauri build --config src-tauri/tauri-lite.conf.json --features lite --bundles deb,appimage,rpm",
    "release:local": "powershell -ExecutionPolicy Bypass -File scripts/release-local.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release-local.ps1",
    "publish:public:dry": "powershell -ExecutionPolicy Bypass -File scripts/publish-public.ps1",
    "publish:public": "powershell -ExecutionPolicy Bypass -File scripts/publish-public.ps1 -Apply -Push",
    "scan-secrets": "python scripts/scan-secrets.py",
    "updater:key": "node scripts/generate-updater-key.mjs",
    "updater:manifest": "node scripts/make-updater-manifest.mjs",
    "sync-intents-assets": "node scripts/sync-near-intents-assets.mjs",
    "check-intents-assets": "node scripts/sync-near-intents-assets.mjs --check",
    "tauri:dev:noswap": "node scripts/run-with-env.mjs tauri dev",
    "bundle:win": "node scripts/bundle-binaries.mjs win32",
    "bundle:linux": "node scripts/assemble-linux-grove.mjs && node scripts/bundle-binaries.mjs linux --runtime-src=.swap-sidecar-work/linux-runtime --grove-bin=.swap-sidecar-work/linux-grove/bin",
    "check-bundle:win": "node scripts/check-bundle-payloads.mjs win32 && node scripts/verify-bundle-deep.mjs win32",
    "check-bundle:linux": "node scripts/check-bundle-payloads.mjs linux && node scripts/verify-bundle-deep.mjs linux",
    "check-bundle:deep": "node scripts/verify-bundle-deep.mjs win32",
    "check-bundle:deep:linux": "node scripts/verify-bundle-deep.mjs linux"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^7.3.0",
    "@fleet-sdk/common": "0.10.0",
    "@fleet-sdk/core": "0.12.0",
    "@fleet-sdk/crypto": "0.11.0",
    "@fleet-sdk/serializer": "0.11.0",
    "@fleet-sdk/wallet": "0.12.0",
    "@mysten/sui": "^1.45.2",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^3.0.0",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "@solana/web3.js": "^1.98.4",
    "@stellar/stellar-base": "^13.1.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "bitcoinjs-lib": "^7.0.1",
    "bs58check": "^4.0.0",
    "buffer": "^6.0.3",
    "ecpair": "^3.0.1",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tiny-secp256k1": "^2.2.4",
    "xrpl": "^4.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.1.5"
  }
}
