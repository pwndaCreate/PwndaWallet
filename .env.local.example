# Template for .env.local — copy to .env.local (gitignored) and fill in.
#
# .env.local is loaded by scripts/release-local.ps1 and forwarded to the
# Docker Linux build via scripts/build-linux-docker.ps1. Without these
# values, AppImages will build but won't be signed — auto-updater clients
# reject unsigned bundles.
#
# Generate the keypair with:
#   npx @tauri-apps/cli signer generate
#
# Paste the PRIVATE key + password below, and paste the PUBLIC key into
# src-tauri/tauri.conf.json under plugins.updater.pubkey (the pubkey is the
# only piece that gets committed).
#
# BACKUP THIS FILE. Losing the private key means existing installs that
# auto-update will reject every future release as untrusted, and there is
# no rotation path that doesn't break them.

TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ── Swap routing flags ───────────────────────────────────────────
#
# VITE_SWAPKIT_LIVE — treat SwapKit quote responses as live (no mock-
# mode UI banner, no broadcast hard-stop). Set to true once the
# wallet-proxy server has cut over to live SwapKit upstream. The
# MOCK_SWAPKIT_ROUTE_ID defense-in-depth in router-modes.ts stays
# armed regardless — if the proxy ever serves the sentinel UUID, the
# UI forces mock-banner mode and broadcast refuses to fire.
#
# VITE_SWAPKIT_CANARY — render a yellow "SwapKit just went live, test
# with a small amount first" banner above the Swap button. Independent
# of VITE_SWAPKIT_LIVE. Intended for the first window after a live
# cutover; flip back to false once the cutover has settled.
#
# See PwndaWalletVault/wiki/concepts/swapkit-live-cutover.md for the
# full cutover protocol.
VITE_SWAPKIT_LIVE=false
VITE_SWAPKIT_CANARY=false
