# Frontend build-time config consumed by Vite (`import.meta.env.VITE_*`).
# Copy to `.env.local` and customize. `.env.local` is gitignored.

# Wallet-proxy base URL — the user-controlled server that fronts SwapKit
# and NEAR Intents 1Click. The Tauri Rust core uses this exact URL; the
# webview never calls upstream APIs directly.
#
# Production default is https://wallet.pwnda.org — the live proxy enforces
# X-Client-Sig auth on /api/*. Override here for local dev against a mock.
VITE_PROXY_URL=https://wallet.pwnda.org

# Default THORName / NEAR Intents referral identifier. Display only —
# the actual affiliate parameters are injected server-side by the proxy
# from its own env.

# Router live/mock flags. Drive the banner color + confirm-modal copy in
# the swap UI. `false` paints a yellow "testing mode (mock data)" banner;
# `true` paints the green "live mode — real funds will move" banner.
#
# SwapKit is mocked upstream by default during the testing phase. Flip to
# `true` once the live SwapKit API key is deployed on the proxy.
# NEAR Intents is live with the user's JWT today.
VITE_SWAPKIT_LIVE=false
VITE_INTENTS_LIVE=true

# Per-chain RPC overrides. Each defaults to a fallback list audited
# 2026-05-06 against working public providers (see `RPC_AUDIT.md` for
# the full pass/fail record). Override any chain by setting the env
# var below; the override is tried FIRST and the audited public
# defaults stay as fallback in case the override flakes.
#
# Canonical names:
#   VITE_<CHAIN>_RPC_URL     for JSON-RPC chains (EVM, Solana, NEAR)
#   VITE_<CHAIN>_API_URL     for REST chains (BTC, LTC, DOGE, BCH)
#
# Recommended overrides (paid endpoints) for production-volume use:
# VITE_ETH_RPC_URL=https://mainnet.infura.io/v3/<key>
# VITE_AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# VITE_POL_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/<key>
# VITE_FLR_RPC_URL=https://flare-api.flare.network/ext/C/rpc
# VITE_ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/<key>
# VITE_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>
# VITE_OP_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/<key>
# VITE_BSC_RPC_URL=https://bsc-dataseed1.binance.org
# VITE_SOL_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<key>
# VITE_NEAR_RPC_URL=https://rpc.mainnet.near.org
# VITE_BTC_API_URL=https://blockstream.info/api
# VITE_LTC_API_URL=https://litecoinspace.org/api
# VITE_DOGE_API_URL=https://api.blockchair.com/dogecoin
# VITE_BCH_API_URL=https://api.blockchair.com/bitcoin-cash

# Quote-flow debug logging. Off by default. Flip to `true` to log every
# outgoing /api/swapkit/quote and /api/intents/quote request body to the
# devtools console under the [QUOTE-DEBUG] prefix.
# VITE_DEBUG_QUOTE=true
